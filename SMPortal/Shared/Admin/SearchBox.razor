@* Search input that only submits on Enter or the magnifier button.
   Fuzzy scoring runs over the whole in-memory list on the single WebAssembly UI thread, so
   searching on every keystroke made the page feel stuck. Nothing happens until the operator
   asks for it. *@
<div class="searchbox-row">
    <label class="searchbox">
        <input type="search" value="@_text" @oninput="OnInput" @onkeydown="OnKeyDown"
               placeholder="@Placeholder" aria-label="@Placeholder" autocomplete="off"
               disabled="@Busy" />
        @if (!string.IsNullOrEmpty(_text))
        {
            <button type="button" class="searchbox-clear" @onclick="Clear" disabled="@Busy"
                    aria-label="Clear search">×</button>
        }
    </label>

    <button type="button" class="searchbox-go" @onclick="Submit" disabled="@Busy"
            title="Search" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" /><path d="m21 21-3.6-3.6" />
        </svg>
    </button>
</div>

@code {
    /// <summary>The term currently applied by the parent.</summary>
    [Parameter] public string Value { get; set; } = "";

    /// <summary>Raised only when the operator submits, never while typing.</summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public string Placeholder { get; set; } = "Search";

    /// <summary>Disables the control while the parent is running a search.</summary>
    [Parameter] public bool Busy { get; set; }

    private string _text = "";

    /// <summary>
    /// The last term this box took from the parent.
    /// </summary>
    /// <remarks>
    /// Tracked separately from <see cref="Value"/> because "has the parent changed its mind?"
    /// and "has the operator typed something?" are different questions, and answering the
    /// first by comparing against <c>_text</c> is what broke this component: the guard here
    /// read <c>if (!_dirty &amp;&amp; _text != Value)</c>, where <c>!_dirty</c> already means
    /// <c>_text == Value</c>. The two clauses are mutually exclusive, so the body never ran
    /// and a parent's term was never adopted — not on a later change, not even on first
    /// render. That is the second time this component's parent-sync has been silently dead;
    /// the first was <c>Value="_search"</c> passing the literal string.
    /// </remarks>
    private string _applied = "";

    // True when the box no longer matches what has actually been searched for.
    private bool _dirty => _text != (Value ?? "");

    protected override void OnParametersSet()
    {
        var incoming = Value ?? "";

        // Adopt only when the parent's own term has moved. A parent re-rendering for an
        // unrelated reason leaves incoming equal to what was last adopted, so a term the
        // operator is midway through typing survives.
        if (incoming != _applied)
        {
            _applied = incoming;
            _text = incoming;
        }
    }

    private void OnInput(ChangeEventArgs args) => _text = args.Value?.ToString() ?? "";

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or "NumpadEnter")
        {
            await Submit();
        }
        else if (args.Key == "Escape")
        {
            await Clear();
        }
    }

    private async Task Submit()
    {
        if (!_dirty) return;
        await ValueChanged.InvokeAsync(_text);
    }

    private async Task Clear()
    {
        _text = "";
        if (!string.IsNullOrEmpty(Value))
        {
            await ValueChanged.InvokeAsync("");
        }
    }
}
