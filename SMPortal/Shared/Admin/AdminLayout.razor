@inherits LayoutComponentBase
@implements IDisposable
@inject IToastService Toast
@inject IAdminDataService Data

@* Chrome deliberately reuses the operations-portal class names (.app-shell/.sidebar/.topbar/
   .navigation/.nav-icon/.main-content) so app.css styles it exactly like the rest of the
   product. The extra .shell class carries the admin design tokens from admin.css. *@
<CascadingValue Value="this">
  <div class="app-shell shell @(navOpen ? "nav-open" : null)">
    <button class="nav-backdrop" aria-label="Close navigation" @onclick="CloseNav"></button>

    <aside class="sidebar" aria-label="Primary navigation">
      @* Plain text, not a link: the dashboard already has its own nav entry below, so a second
         route to it dressed as a logo was a redundant target. *@
      <div class="sidebar-head">
        <p class="sidebar-title" id="admin-nav-label">Administration Dashboard</p>
        <button type="button" class="sidebar-close" aria-label="Close navigation" @onclick="CloseNav">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <nav class="navigation" aria-labelledby="admin-nav-label">
        <span class="nav-heading">Overview</span>
        <NavLink href="admin" Match="NavLinkMatch.All" @onclick="CloseNav">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>Dashboard
        </NavLink>

        <span class="nav-heading section">Sales</span>
        <NavLink href="admin/quotes" @onclick="CloseNav">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>Quotes
        </NavLink>
        <NavLink href="admin/orders" @onclick="CloseNav">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18M16 10a4 4 0 0 1-8 0"/></svg>Orders
        </NavLink>

        <span class="nav-heading section">Customers</span>
        <NavLink href="admin/accounts" @onclick="CloseNav">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21V7a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v14M13 21V11h6a2 2 0 0 1 2 2v8M2 21h20M7 9h2M7 13h2M7 17h2M17 15h1M17 18h1"/></svg>Accounts
        </NavLink>
        <NavLink href="admin/groups" @onclick="CloseNav">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13A4 4 0 0 1 16 11"/></svg>Customer groups
        </NavLink>

        <span class="nav-heading section">Catalog</span>
        <NavLink href="admin/products" @onclick="CloseNav">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 16-9 5-9-5V8l9-5 9 5z"/><path d="m3 8 9 5 9-5M12 13v8"/></svg>Products &amp; stock
        </NavLink>
        <NavLink href="admin/feeds" @onclick="CloseNav">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 2v6h-6M3 12a9 9 0 0 1 15-6.7L21 8M3 22v-6h6M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>Distributor feeds
        </NavLink>

        <span class="nav-heading section">Administration</span>
        <NavLink href="admin/users" @onclick="CloseNav">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>Users &amp; roles
        </NavLink>
        <NavLink href="admin/reports" @onclick="CloseNav">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V4M4 20h16"/><path d="M8 17v-5M13 17V8M18 17v-3"/></svg>Reports
        </NavLink>
      </nav>

      <div class="sidebar-footer">
        <span class="status-dot" aria-hidden="true"></span>
        <span><strong>API connected</strong><small>Secure workspace</small></span>
      </div>
    </aside>

    <div class="workspace">
      <header class="topbar">
        <button class="icon-button menu-button" aria-label="Open navigation" aria-expanded="@navOpen" @onclick="ToggleNav">
          <span></span><span></span><span></span>
        </button>
        <div class="topbar-context">
          <strong>@Title</strong>
          <span>@Subtitle</span>
        </div>
        <AuthorizeView>
          <Authorized Context="auth">
            <div class="account">
              <span class="avatar" aria-hidden="true">@Initial(auth.User)</span>
              <span class="account-copy">
                <strong>@DisplayName(auth.User)</strong>
                <small>@RoleSummary(auth.User)</small>
              </span>
              <NavLink class="button ghost compact" href="logout">Sign out</NavLink>
            </div>
          </Authorized>
        </AuthorizeView>
      </header>

      <main class="main-content">
        @if (loadError is not null)
        {
          <div class="alert error" role="alert">
            <strong>The StockManager API could not be reached.</strong>
            <span>@loadError</span>
          </div>
        }
        else if (!loaded)
        {
          @* Pages read the snapshot in OnInitialized, so nothing renders until it is filled. *@
          <div class="route-state" role="status">
            <span class="spinner" aria-hidden="true"></span>
            <strong>Loading workspace</strong>
            <span>Fetching accounts, quotes and stock.</span>
          </div>
        }
        else
        {
          @Body
        }
      </main>
    </div>

    @if (Toast.Current is not null)
    {
      <div class="toast">
        <svg viewBox="0 0 24 24" fill="none" stroke="#1bfbf9" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
        <span>@Toast.Current</span>
      </div>
    }
  </div>
</CascadingValue>

@code {
    private bool navOpen;
    private bool loaded;
    private string? loadError;

    public string Title { get; private set; } = "Dashboard";
    public string Subtitle { get; private set; } = "";

    // Pages call this from OnParametersSet to drive the top bar.
    public void SetPage(string title, string subtitle)
    {
        if (Title == title && Subtitle == subtitle) return;
        Title = title;
        Subtitle = subtitle;
        InvokeAsync(StateHasChanged);
    }

    private void ToggleNav() => navOpen = !navOpen;
    private void CloseNav() => navOpen = false;

    protected override async Task OnInitializedAsync()
    {
        Toast.OnChange += OnToastChanged;

        try
        {
            await Data.EnsureLoadedAsync();
            loaded = true;
        }
        catch (Exception exception)
        {
            loadError = exception.Message;
        }
    }

    private void OnToastChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Toast.OnChange -= OnToastChanged;

    private static string DisplayName(ClaimsPrincipal user) =>
        user.FindFirst(ClaimTypes.Name)?.Value ?? "Signed-in user";

    private static string Initial(ClaimsPrincipal user)
    {
        var value = DisplayName(user);
        return value.Length > 0 ? value[..1].ToUpperInvariant() : "U";
    }

    private static string RoleSummary(ClaimsPrincipal user)
    {
        var roles = user.FindAll(ClaimTypes.Role).Select(claim => claim.Value).Distinct().ToArray();
        return roles.Length == 0 ? "Authenticated" : string.Join(" / ", roles);
    }
}
