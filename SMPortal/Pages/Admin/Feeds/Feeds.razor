@page "/admin/feeds"
@inject IAdminDataService Data
@inject IToastService Toast

<PageTitle>Distributor feeds · StockManager</PageTitle>

<div class="page-head">
    <div>
        <span class="eyebrow">Catalog sources</span>
        <h1>Distributor feeds</h1>
    </div>
    <div class="head-actions">
        <button class="btn btn-secondary" @onclick="SyncAll" disabled="@_busy">Sync all</button>
        <button class="btn btn-primary" @onclick="OpenNew" disabled="@_busy">Add feed</button>
    </div>
</div>

<div class="panel panel-clip">
    <div class="toolbar">
        <SearchBox Value="@_search" ValueChanged="OnSearch" Busy="_searching" Placeholder="Search feed or host" />
        <span class="toolbar-count"><strong>@Results.Count</strong> configured</span>
    </div>

    @if (Data.Feeds.Count == 0)
    {
        <div class="empty-state">
            <strong>No distributor feeds yet</strong>
            <span>Add a feed to pull stock automatically, or keep adding products from your own warehouse.</span>
        </div>
    }
    else
    {
        <BusyOverlay Busy="_searching">
        <div class="tbl-wrap">
            <table class="tbl">
                <thead>
                    <tr>
                        <th class="lead">Feed</th>
                        <th>Host</th>
                        <th>Credential</th>
                        <th>Host key</th>
                        <th>Last sync</th>
                        <th class="ctr">Enabled</th>
                        <th class="trail num">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var feed in Paged)
                    {
                        <tr>
                            <td class="lead">
                                <span class="cell-primary">@feed.Name</span>
                                <span class="cell-sub">@feed.Username</span>
                            </td>
                            <td><span class="mono">@feed.Host:@feed.Port</span></td>
                            <td>
                                @if (feed.HasCredential)
                                {
                                    <span class="badge badge--ok">Stored (@feed.SecretProvider)</span>
                                }
                                else
                                {
                                    <span class="badge badge--danger">Missing</span>
                                }
                            </td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(feed.HostKeySha256))
                                {
                                    <span class="badge badge--warn" title="The SFTP host is not verified">Unverified</span>
                                }
                                else
                                {
                                    <span class="badge badge--ok">Pinned</span>
                                }
                            </td>
                            <td>
                                @if (feed.LastSyncedUtc is null)
                                {
                                    <span class="cell-sub">Never</span>
                                }
                                else
                                {
                                    <span class="cell-strong">@feed.LastSyncedUtc.Value.ToString("dd MMM yyyy HH:mm")</span>
                                    <span class="cell-sub">@feed.LastSyncStatus</span>
                                }
                            </td>
                            <td class="ctr">
                                @if (feed.Enabled)
                                {
                                    <span class="badge badge--ok">On</span>
                                }
                                else
                                {
                                    <span class="badge badge--neutral">Off</span>
                                }
                            </td>
                            <td class="trail num">
                                <button class="btn btn-sm btn-secondary" @onclick="() => OpenEdit(feed)" disabled="@_busy">Edit</button>
                                <button class="btn btn-sm btn-secondary" @onclick="() => Sync(feed)" disabled="@_busy">Sync</button>
                                <button class="btn btn-sm btn-danger-outline" @onclick="() => Delete(feed)" disabled="@_busy">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </BusyOverlay>
        <Pager TotalCount="Results.Count" Page="_page" PageChanged="p => _page = p"
               PageSize="_pageSize" PageSizeChanged="OnPageSizeChanged" />
    }
</div>

<Modal Visible="_showEdit" Title="@(_draft.Id == 0 ? "Add distributor feed" : "Edit distributor feed")" OnClose="Close">
    <EditForm Model="_draft" OnValidSubmit="Save">
        <div class="modal-body">
            <div class="form-grid">
                <div class="field span2">
                    <label>Name</label>
                    <InputText class="input" @bind-Value="_draft.Name" placeholder="Flexit Distribution" />
                </div>
                <div class="field">
                    <label>Host</label>
                    <InputText class="input" @bind-Value="_draft.Host" placeholder="sftp.example.com" />
                </div>
                <div class="field">
                    <label>Port</label>
                    <input class="input" type="number" min="1" max="65535" value="@_draft.Port" @onchange="SetPort" />
                    <span class="field-note">SFTP is normally 22.</span>
                </div>
                <div class="field">
                    <label>Username</label>
                    <InputText class="input" @bind-Value="_draft.Username" autocomplete="off" />
                </div>
                <div class="field">
                    <label>Password</label>
                    <InputText class="input" type="password" @bind-Value="_draft.Password" autocomplete="new-password"
                               placeholder="@(_draft.HasCredential ? "Leave blank to keep current" : "Required")" />
                </div>
                <div class="field span2">
                    <label>Remote directory</label>
                    <InputText class="input" @bind-Value="_draft.RemoteDirectory" />
                </div>
                <div class="field span2">
                    <label>Host key SHA-256 (recommended)</label>
                    <InputText class="input" @bind-Value="_draft.HostKeySha256" placeholder="Base64 fingerprint" />
                </div>
            </div>

            <p class="hint">
                Without a host key fingerprint the SFTP server is not verified. Ask the distributor
                for it, or take it from a first connection you trust.
            </p>

            <span class="card-kicker">Field mapping</span>
            <p class="hint">
                Each box takes the name of the element in the distributor's XML, not your own
                column name. Anything left blank is simply not imported — that is silent, so the
                unmapped ones are called out below.
            </p>
            <div class="form-grid">
                <div class="field">
                    <label>SKU</label>
                    <InputText class="input" @bind-Value="_draft.FieldSku" placeholder="e.g. PartNumber" />
                    <span class="field-note @(string.IsNullOrWhiteSpace(_draft.FieldSku) ? "field-note--warn" : null)">
                        @(string.IsNullOrWhiteSpace(_draft.FieldSku) ? "Required — rows cannot be matched without it." : "Keys the upsert.")
                    </span>
                </div>
                <div class="field"><label>Name</label><InputText class="input" @bind-Value="_draft.FieldName" /></div>
                <div class="field"><label>Description</label><InputText class="input" @bind-Value="_draft.FieldDescription" /></div>
                <div class="field"><label>Category</label><InputText class="input" @bind-Value="_draft.FieldCategory" /></div>
                <div class="field"><label>Cost</label><InputText class="input" @bind-Value="_draft.FieldCost" /></div>
                <div class="field"><label>SRP</label><InputText class="input" @bind-Value="_draft.FieldSrp" /></div>
                <div class="field"><label>Quantity</label><InputText class="input" @bind-Value="_draft.FieldQuantity" /></div>

                @* These four were left blank on the Flex it feed, so Manufacturer,
                   ManufacturerPartNumber and Ean came back NULL on every one of its products —
                   and nothing on screen said why. *@
                <div class="field">
                    <label>Manufacturer</label>
                    <InputText class="input" @bind-Value="_draft.FieldManufacturer" />
                    <span class="field-note">@Unmapped(_draft.FieldManufacturer, "brand search")</span>
                </div>
                <div class="field">
                    <label>Manufacturer part no.</label>
                    <InputText class="input" @bind-Value="_draft.FieldMpn" />
                    <span class="field-note">@Unmapped(_draft.FieldMpn, "MPN lookup and Icecat images")</span>
                </div>
                <div class="field">
                    <label>EAN / GTIN</label>
                    <InputText class="input" @bind-Value="_draft.FieldEan" />
                    <span class="field-note">@Unmapped(_draft.FieldEan, "barcode search and Icecat fallback")</span>
                </div>
                <div class="field">
                    <label>Icecat flag</label>
                    <InputText class="input" @bind-Value="_draft.FieldIcecat" />
                    <span class="field-note">@Unmapped(_draft.FieldIcecat, "the image enrichment filter")</span>
                </div>

                <div class="field span2">
                    <label class="switch-row">
                        <InputCheckbox @bind-Value="_draft.Enabled" />
                        <span>Enabled</span>
                    </label>
                    <span class="field-note">
                        @(_draft.Enabled ? "Included in the next sync." : "Kept on file but skipped by syncs.")
                    </span>
                </div>
            </div>

            @if (_testResult is not null)
            {
                <div class="alert @(_testResult.Succeeded ? "success" : "error")" role="status">
                    <strong>@(_testResult.Succeeded ? "Connection succeeded" : "Connection failed")</strong>
                    <span>
                        @(_testResult.Succeeded
                            ? $"Read {_testResult.RecordCount} records from the newest file. Nothing was imported."
                            : _testResult.Error)
                    </span>
                </div>

                @* What the feed actually contains. A mapping above that names a field the feed
                   does not have imports as NULL on every row while the sync still reports
                   success, so the fix is to copy names from here rather than guess them. *@
                @if (_testResult.DiscoveredFields.Count > 0)
                {
                    <details class="feed-fields" open>
                        <summary>Fields found in this feed (@_testResult.DiscoveredFields.Count)</summary>
                        <table class="feed-fields__table">
                            <thead>
                                <tr>
                                    <th>Field</th>
                                    <th>Populated</th>
                                    <th>Example</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var field in _testResult.DiscoveredFields)
                                {
                                    <tr>
                                        <td><code>@field.Name</code></td>
                                        <td class="feed-fields__pct">@field.PopulatedPct%</td>
                                        <td class="feed-fields__sample">@field.SampleValue</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </details>
                }
            }
        </div>
        <div class="modal-foot">
            <button type="button" class="btn btn-secondary" @onclick="Close">Close</button>
            <button type="button" class="btn btn-secondary" @onclick="Test" disabled="@_busy">Test connection</button>
            <button type="submit" class="btn btn-primary" disabled="@_busy">Save feed</button>
        </div>
    </EditForm>
</Modal>

@code {
    [CascadingParameter] public AdminLayout? Layout { get; set; }

    private int _page = 1;
    private int _pageSize = 25;

    private string _search = "";
    private readonly SearchCache<DistributorFeedView> _cache = new();

    private List<DistributorFeedView> Results => _cache.Get(
        $"{_search}|{Data.Feeds.Count}",
        () => FuzzySearch.Rank(Data.Feeds, _search,
            f => new[] { f.Name },
            f => new[] { f.Host, f.Username }));

    private IEnumerable<DistributorFeedView> Paged => Results.Skip((_page - 1) * _pageSize).Take(_pageSize);

    private bool _searching;

    // Scoring runs on the single WebAssembly UI thread. Yield once first so the browser can
    // paint the busy overlay before the work starts, rather than the page appearing frozen.
    private async Task OnSearch(string term)
    {
        // Raise the overlay while _search still holds the PREVIOUS term: the memoised cache
        // returns the old results, so this render is cheap and the browser can paint it.
        // Applying the new term first made this very render run the scoring synchronously,
        // which is why the spinner never appeared.
        _searching = true;
        StateHasChanged();

        // Long enough for a paint frame (~16ms); Task.Delay(1) was not.
        await Task.Delay(80);

        _search = term;
        _page = 1;

        // Now do the work, with the overlay already on screen.
        _ = Results.Count;

        _searching = false;
    }

    private void OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _page = 1;
    }

    private bool _showEdit;
    private bool _busy;
    private DistributorFeedView _draft = new();

    private void SetPort(ChangeEventArgs args) =>
        _draft.Port = int.TryParse(args.Value?.ToString(), out var value)
            ? Math.Clamp(value, 1, 65535)
            : 22;

    // Says which downstream feature goes dark, rather than just "empty".
    private static string Unmapped(string? mapping, string feature) =>
        string.IsNullOrWhiteSpace(mapping)
            ? $"Not mapped — {feature} will not work for this feed."
            : "Mapped.";

    private FeedSyncOutcome? _testResult;

    protected override void OnParametersSet() =>
        Layout?.SetPage("Distributor feeds", "Stock sources and import credentials");

    private void OpenNew()
    {
        _draft = new DistributorFeedView();
        _testResult = null;
        _showEdit = true;
    }

    private void OpenEdit(DistributorFeedView feed)
    {
        // Copied so cancelling an edit does not mutate the row shown in the table. Password is
        // never populated — the API does not return it.
        _draft = new DistributorFeedView
        {
            Id = feed.Id,
            Name = feed.Name,
            Host = feed.Host,
            Port = feed.Port,
            Username = feed.Username,
            RemoteDirectory = feed.RemoteDirectory,
            HostKeySha256 = feed.HostKeySha256,
            Enabled = feed.Enabled,
            HasCredential = feed.HasCredential,
            SecretProvider = feed.SecretProvider,
            FieldSku = feed.FieldSku,
            FieldName = feed.FieldName,
            FieldDescription = feed.FieldDescription,
            FieldCategory = feed.FieldCategory,
            FieldCost = feed.FieldCost,
            FieldSrp = feed.FieldSrp,
            FieldQuantity = feed.FieldQuantity,
            FieldManufacturer = feed.FieldManufacturer,
            FieldMpn = feed.FieldMpn,
            FieldEan = feed.FieldEan,
            FieldIcecat = feed.FieldIcecat
        };
        _testResult = null;
        _showEdit = true;
    }

    private void Close()
    {
        _showEdit = false;
        _draft.Password = null;
        _testResult = null;
    }

    private async Task Test()
    {
        _busy = true;
        try
        {
            _testResult = await Data.TestFeed(_draft);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Save()
    {
        if (_draft.Id == 0 && string.IsNullOrWhiteSpace(_draft.Password))
        {
            _testResult = new FeedSyncOutcome { Succeeded = false, Error = "A password is required for a new feed." };
            return;
        }

        _busy = true;
        try
        {
            // Verify before storing, so a bad credential is caught now rather than at the next sync.
            var check = await Data.TestFeed(_draft);
            if (!check.Succeeded)
            {
                _testResult = check;
                Toast.Show("Feed not saved — the connection test failed.");
                return;
            }

            await Data.SaveFeed(_draft);
            _draft.Password = null;
            _showEdit = false;
            Toast.Show("Feed saved");
        }
        catch (Exception exception)
        {
            _testResult = new FeedSyncOutcome { Succeeded = false, Error = exception.Message };
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Sync(DistributorFeedView feed)
    {
        _busy = true;
        try
        {
            var result = await Data.SyncFeed(feed.Id);
            Toast.Show(result.Succeeded
                ? $"{feed.Name}: imported {result.Imported} of {result.RecordCount}, {result.Delisted} delisted"
                : $"{feed.Name} failed: {result.Error}");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SyncAll()
    {
        _busy = true;
        try
        {
            await Data.SyncFeeds();
            Toast.Show("Distributor feeds synced");
        }
        catch (Exception exception)
        {
            Toast.Show($"Sync failed: {exception.Message}");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Delete(DistributorFeedView feed)
    {
        _busy = true;
        try
        {
            await Data.DeleteFeed(feed.Id);
            Toast.Show($"{feed.Name} removed. Products it imported were kept.");
        }
        finally
        {
            _busy = false;
        }
    }
}
