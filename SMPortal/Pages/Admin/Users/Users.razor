@page "/admin/users"
@inject IAdminDataService Data
@inject IToastService Toast

<PageTitle>Users &amp; roles · StockManager</PageTitle>

@if (!Data.ManagesAllStores)
{
    @* Staff are not one store's, so the API refuses this page's every call to an admin given
       only some stores (T9); saying so beats an empty list and an Add button that fails. *@
    <div class="page-head">
        <div><span class="eyebrow">Administration</span><h1>Users &amp; roles</h1></div>
    </div>
    <div class="alert users-restricted" role="status">
        Staff are managed by an admin of every store. Ask one to change who can act for which store.
    </div>
}
else
{
<div class="page-head">
    <div><span class="eyebrow">Administration</span><h1>Users &amp; roles</h1></div>
    <div class="head-actions">
        <button class="btn btn-primary" @onclick="() => _showInvite = true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>Add user
        </button>
    </div>
</div>

<div class="panel panel-clip">
    <div class="toolbar">
        <h2 class="tbl-title">Team accounts</h2>
        <SearchBox Value="@_search" ValueChanged="OnSearch" Busy="_searching" Placeholder="Search name, email or role" />
        <div class="toolbar-count"><strong>@Results.Count</strong> members</div>
    </div>
    <BusyOverlay Busy="_searching">
    <div class="tbl-wrap">
        <table class="tbl">
            <thead><tr><th class="lead">User</th><th>Roles</th><th>Stores</th><th class="trail"></th></tr></thead>
            <tbody>
                @foreach (var u in Paged)
                {
                    <tr>
                        <td class="lead">
                            <div class="user-cell">
                                <span class="user-ini">@AdminUi.Initials(u.Name)</span>
                                <div><strong>@u.Name</strong><small>@u.Email</small></div>
                            </div>
                        </td>
                        <td>
                            <div class="role-chips">
                                @foreach (var r in u.RoleList) { <span class="role-chip">@r</span> }
                            </div>
                        </td>
                        <td><span class="user-stores">@StoresLabel(u)</span></td>
                        <td class="trail"><button class="btn btn-secondary btn-sm" @onclick="() => OpenManage(u)">Manage</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </BusyOverlay>
    <Pager TotalCount="Results.Count" Page="_page" PageChanged="p => _page = p"
           PageSize="_pageSize" PageSizeChanged="OnPageSizeChanged" />
</div>

<Modal Visible="_showInvite" Title="Add user" OnClose="() => _showInvite = false">
    <EditForm Model="_invite" OnValidSubmit="SendInvite">
        <div class="modal-body">
            <div class="form-grid">
                <div class="field span2">
                    <label>Full name</label>
                    <InputText class="input" @bind-Value="_invite.Name" />
                </div>
                <div class="field">
                    <label>Email</label>
                    <InputText class="input" type="email" @bind-Value="_invite.Email" />
                    <span class="field-note @(InviteProblem is not null ? "field-note--warn" : null)">
                        @(InviteProblem ?? "Their sign-in address.")
                    </span>
                </div>
                <div class="field">
                    <label>Role</label>
                    <InputSelect class="input" @bind-Value="_invite.Role"><option>Staff</option><option>Manager</option><option>Admin</option></InputSelect>
                    <span class="field-note">@RoleBlurb(_invite.Role)</span>
                </div>
                <div class="field span2">
                    <label>First password</label>
                    <InputText class="input" type="password" autocomplete="new-password" @bind-Value="_invite.Password" />
                    @* There is no staff mail to send an invitation by, so the admin chooses this, hands
                       it over, and the new user changes it once signed in. *@
                    <span class="field-note invite-error @(_inviteError is not null ? "field-note--warn" : null)">
                        @(_inviteError ?? "Give it to them yourself. They change it from Change password once signed in.")
                    </span>
                </div>
                <div class="field span2">
                    @StorePicker(_inviteStores)
                </div>
            </div>
        </div>
        <div class="modal-foot">
            <button type="button" class="btn btn-secondary" @onclick="() => _showInvite = false">Close</button>
            <button type="submit" class="btn btn-primary" disabled="@(!CanInvite)">Add user</button>
        </div>
    </EditForm>
</Modal>

<Modal Visible="_showManage" Title="Manage access" OnClose="() => _showManage = false">
    <div class="modal-body">
        @if (_sel is not null)
        {
            <div class="manage-user">
                <span class="user-ini">@AdminUi.Initials(_sel.Name)</span>
                <div><strong>@_sel.Name</strong><small>@_sel.Email</small></div>
            </div>
            <span class="field-label mb">Assigned roles</span>
            <label class="role-check"><input type="checkbox" @bind="_rAdmin" /> Admin — full access</label>
            <label class="role-check"><input type="checkbox" @bind="_rManager" /> Manager — inventory, reports</label>
            <label class="role-check"><input type="checkbox" @bind="_rStaff" /> Staff — products &amp; quotes</label>

            @* Saving no roles silently locked the user out of every page, which read as a bug
               rather than a choice. *@
            <span class="field-note @(NoRoles ? "field-note--warn" : null)">
                @(NoRoles
                    ? "With no role assigned they can sign in but reach nothing."
                    : _rAdmin
                        ? "Admin already covers everything the other two grant."
                        : "Roles add up — assign more than one where needed.")
            </span>

            @StorePicker(_manageStores)

            @if (_manageError is not null)
            {
                <span class="field-note field-note--warn manage-error">@_manageError</span>
            }
        }
    </div>
    <div class="modal-foot">
        <button type="button" class="btn btn-secondary" @onclick="() => _showManage = false">Close</button>
        <button type="button" class="btn btn-primary" @onclick="SaveAccess">Save</button>
    </div>
</Modal>
}

@code {
    [CascadingParameter] public AdminLayout? Layout { get; set; }

    private int _page = 1;
    private int _pageSize = 25;

    private string _search = "";
    private readonly SearchCache<User> _cache = new();

    private List<User> Results => _cache.Get(
        $"{_search}|{Data.Users.Count}",
        () => FuzzySearch.Rank(Data.Users, _search,
            u => new[] { u.Name, u.Roles },
            u => new[] { u.Email }));

    private IEnumerable<User> Paged => Results.Skip((_page - 1) * _pageSize).Take(_pageSize);

    private bool _searching;

    // Scoring runs on the single WebAssembly UI thread. Yield once first so the browser can
    // paint the busy overlay before the work starts, rather than the page appearing frozen.
    private async Task OnSearch(string term)
    {
        // Raise the overlay while _search still holds the PREVIOUS term: the memoised cache
        // returns the old results, so this render is cheap and the browser can paint it.
        // Applying the new term first made this very render run the scoring synchronously,
        // which is why the spinner never appeared.
        _searching = true;
        StateHasChanged();

        // Long enough for a paint frame (~16ms); Task.Delay(1) was not.
        await Task.Delay(80);

        _search = term;
        _page = 1;

        // Now do the work, with the overlay already on screen.
        _ = Results.Count;

        _searching = false;
    }

    private void OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _page = 1;
    }

    private bool _showInvite, _showManage;
    private User? _sel;
    private bool _rAdmin, _rManager, _rStaff;

    private sealed class Invite { public string Name { get; set; } = ""; public string Email { get; set; } = ""; public string Role { get; set; } = "Staff"; public string Password { get; set; } = ""; }
    private Invite _invite = new();
    private string? _inviteError;

    private bool NoRoles => !_rAdmin && !_rManager && !_rStaff;

    private string? InviteProblem
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_invite.Email)) return null;

            if (!_invite.Email.Contains('@') || _invite.Email.EndsWith('@'))
            {
                return "Does not look like an email address.";
            }

            return Data.Users.Any(u => string.Equals(u.Email, _invite.Email, StringComparison.OrdinalIgnoreCase))
                ? "That address already has an account."
                : null;
        }
    }

    private bool CanInvite =>
        !string.IsNullOrWhiteSpace(_invite.Name) &&
        !string.IsNullOrWhiteSpace(_invite.Email) &&
        !string.IsNullOrEmpty(_invite.Password) &&
        InviteProblem is null;

    private static string RoleBlurb(string role) => role switch
    {
        "Admin" => "Everything, including users and feeds.",
        "Manager" => "Inventory, quotes, orders and reports.",
        _ => "Products and quotes only."
    };

    protected override void OnParametersSet() => Layout?.SetPage("Users & roles", "Internal team access control");

    private void OpenManage(User u)
    {
        _sel = u;
        var roles = u.RoleList.ToHashSet();
        _rAdmin = roles.Contains("Admin");
        _rManager = roles.Contains("Manager");
        _rStaff = roles.Contains("Staff");
        _manageStores = new StoreChoice { All = u.AllSites, Ids = u.SiteIds.ToHashSet() };
        _manageError = null;
        _showManage = true;
    }

    private async Task SaveAccess()
    {
        if (_sel is null) return;
        var roles = new List<string>();
        if (_rAdmin) roles.Add("Admin");
        if (_rManager) roles.Add("Manager");
        if (_rStaff) roles.Add("Staff");

        // The API refuses to leave the deployment without an admin of every store, and that
        // has to reach the admin as words rather than as a closed dialog and a stale list.
        _manageError = await Data.UpdateUserAccess(_sel.Id, roles, _manageStores.All, _manageStores.Ids);
        if (_manageError is not null) return;

        _showManage = false;
        Toast.Show("Access updated");
    }

    private async Task SendInvite()
    {
        _inviteError = await Data.AddUser(_invite.Name, _invite.Email, _invite.Role, _invite.Password,
            _inviteStores.All, _inviteStores.Ids);

        if (_inviteError is not null) return;

        _showInvite = false;
        _invite = new();
        _inviteStores = new();
        Toast.Show("User added");
    }

    // ---- Stores (T9) --------------------------------------------------------------------------

    // Every store, or exactly the ticked ones. Nothing ticked is a real answer — a colleague
    // who can sign in and change their password but act for no store — so it is not refused,
    // only said.
    private sealed class StoreChoice
    {
        public bool All { get; set; }
        public HashSet<int> Ids { get; set; } = new();
    }

    private StoreChoice _inviteStores = new();
    private StoreChoice _manageStores = new();
    private string? _manageError;

    private RenderFragment StorePicker(StoreChoice choice) =>
        @<div class="store-picker">
            <span class="field-label mb">Stores</span>
            <label class="role-check">
                <input type="checkbox" class="store-all" checked="@choice.All"
                       @onchange="args => choice.All = args.Value is true" />
                All stores — including stores added later, and managing staff
            </label>
            @foreach (var site in Data.Sites)
            {
                var id = site.Id;
                <label class="role-check">
                    <input type="checkbox" class="store-one" value="@site.SiteKey" disabled="@choice.All"
                           checked="@(choice.All || choice.Ids.Contains(id))"
                           @onchange="args => Toggle(choice, id, args.Value is true)" />
                    @site.Name
                </label>
            }
            <span class="field-note @(!choice.All && choice.Ids.Count == 0 ? "field-note--warn" : null)">
                @(choice.All
                    ? "They can act for every store, and manage staff."
                    : choice.Ids.Count == 0
                        ? "With no store they can sign in but see no store's customers, quotes or orders."
                        : "They can act only for the ticked stores, and cannot manage staff.")
            </span>
        </div>;

    private static void Toggle(StoreChoice choice, int siteId, bool on)
    {
        if (on) choice.Ids.Add(siteId);
        else choice.Ids.Remove(siteId);
    }

    private string StoresLabel(User u)
    {
        if (u.AllSites) return "All stores";

        var names = Data.Sites.Where(site => u.SiteIds.Contains(site.Id)).Select(site => site.Name).ToList();

        return names.Count == 0 ? "None" : string.Join(", ", names);
    }
}
