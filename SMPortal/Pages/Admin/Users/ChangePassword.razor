@page "/admin/password"
@inject IAdminDataService Data
@inject IToastService Toast

<PageTitle>Change password · StockManager</PageTitle>

<div class="page-head">
    <div><span class="eyebrow">Your account</span><h1>Change password</h1></div>
</div>

@* For every member of staff, about their own login only: the API takes the user from the
   token, never from this form. An admin chose the first password, so until it is changed here
   two people know it. *@
<div class="panel panel-pad">
    <EditForm Model="_form" OnValidSubmit="Save">
        <div class="form-grid">
            <div class="field span2">
                <label for="current-password">Current password</label>
                <InputText id="current-password" class="input" type="password" autocomplete="current-password" @bind-Value="_form.Current" />
            </div>
            <div class="field">
                <label for="new-password">New password</label>
                <InputText id="new-password" class="input" type="password" autocomplete="new-password" @bind-Value="_form.Next" />
            </div>
            <div class="field">
                <label for="confirm-password">New password again</label>
                <InputText id="confirm-password" class="input" type="password" autocomplete="new-password" @bind-Value="_form.Confirm" />
                <span class="field-note password-status @(Problem is not null ? "field-note--warn" : null)">
                    @(Problem ?? "At least six characters, with an upper and lower case letter, a digit and a symbol.")
                </span>
            </div>
        </div>
        <button type="submit" class="btn btn-primary mt password-save" disabled="@(!CanSave)">Change password</button>
    </EditForm>
</div>

@code {
    [CascadingParameter] public AdminLayout? Layout { get; set; }

    private sealed class Form
    {
        public string Current { get; set; } = "";
        public string Next { get; set; } = "";
        public string Confirm { get; set; } = "";
    }

    private Form _form = new();
    private string? _refusal;
    private bool _saving;

    private string? Problem =>
        _refusal ?? (_form.Confirm.Length > 0 && _form.Confirm != _form.Next ? "The two new passwords differ." : null);

    private bool CanSave =>
        !_saving
        && _form.Current.Length > 0
        && _form.Next.Length > 0
        && _form.Next == _form.Confirm;

    protected override void OnParametersSet() => Layout?.SetPage("Change password", "Your own sign-in");

    private async Task Save()
    {
        _saving = true;
        _refusal = await Data.ChangePassword(_form.Current, _form.Next);
        _saving = false;

        if (_refusal is not null) return;

        _form = new();
        Toast.Show("Password changed");
    }
}
