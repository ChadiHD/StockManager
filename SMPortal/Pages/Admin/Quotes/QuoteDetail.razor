@page "/admin/quotes/{Id}"
@inject IAdminDataService Data
@inject NavigationManager Nav
@inject IToastService Toast

<PageTitle>Quote @Id · StockManager</PageTitle>

<button class="back-btn" @onclick='() => Nav.NavigateTo("admin/quotes")'>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>Back to quotes
</button>

@if (_q is null)
{
    <div class="panel panel-pad">Quote <strong>@Id</strong> was not found.</div>
}
else
{
    <div class="page-head">
        <div>
            <span class="eyebrow">Quote @_q.Id</span>
            <div class="detail-title"><h1>@_q.Account</h1><span class="badge @AdminUi.StatusClass(_q.Status)">@_q.Status</span></div>
            <p class="detail-sub">Created @_q.Created · Valid until @_q.Expires · Priced in @_q.Currency</p>
        </div>
        <div class="head-actions">
            <button class="btn btn-secondary quote-save" disabled="@(!HasEdits || _saving)" @onclick="SaveDraft">
                @(HasEdits ? $"Save draft ({_edits.Count})" : "Save draft")
            </button>
            <button class="btn btn-secondary quote-send" disabled="@_saving" @onclick="SendQuote">Send to customer</button>
            <button class="btn btn-primary" @onclick="ConvertToOrder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>Convert to order
            </button>
        </div>
    </div>

    <div class="detail-grid">
        <div class="stack">
            <div class="panel panel-clip">
                <div class="lines-head">
                    <span class="card-kicker">Line items</span>
                    <h2>@_q.LineItems.Count products</h2>
                    @if (!CanEditLines)
                    {
                        <p class="lines-locked">Accepted and converted to an order — its lines can no longer be re-priced or removed.</p>
                    }
                </div>
                <div class="tbl-wrap">
                    <table class="tbl">
                        <thead><tr><th class="lead">Item</th><th class="ctr">Qty</th><th class="num">List</th><th class="ctr">Disc</th><th class="num">Unit net</th><th class="num">Line total</th><th class="trail"><span class="vh">Remove</span></th></tr></thead>
                        <tbody>
                            @foreach (var l in _q.LineItems)
                            {
                                <tr class="@(IsEdited(l) ? "row-edited" : null)">
                                    <td class="lead"><span class="cell-strong">@l.Name</span><span class="cell-sub mono">@l.Sku</span></td>
                                    <td class="ctr">
                                        @if (CanEditLines)
                                        {
                                            @* Keyed on the save stamp: once a user types into an input, Blazor
                                               writing the value attribute no longer updates the DOM property, so
                                               a saved row would keep showing the typed text even after the
                                               snapshot moved. A new key forces a new element. *@
                                            <input class="input line-edit" type="number" min="1" step="1"
                                                   @key="@($"q{l.LineId}-{_editStamp}")"
                                                   disabled="@_saving" value="@QtyOf(l)"
                                                   aria-label="@($"Quantity for {l.Sku}")"
                                                   @onchange="args => SetQty(l, args)" />
                                        }
                                        else
                                        {
                                            @l.Qty
                                        }
                                    </td>
                                    <td class="num strike">@AdminUi.Money(l.List, _q.Currency, 2)</td>
                                    <td class="ctr">
                                        @if (CanEditLines)
                                        {
                                            <input class="input line-edit" type="number" min="0" max="100" step="0.01"
                                                   @key="@($"d{l.LineId}-{_editStamp}")"
                                                   disabled="@_saving" value="@DiscOf(l)"
                                                   aria-label="@($"Discount for {l.Sku}")"
                                                   @onchange="args => SetDisc(l, args)" />
                                        }
                                        else
                                        {
                                            <span class="disc-chip">-@(l.Disc.ToString("0.##"))%</span>
                                        }
                                    </td>
                                    @* Net and the line total show what is stored, not a preview of the pending
                                       edit. Previewing would mean a third copy of the net-price expression --
                                       after fnCatalog_VisibleProducts and PriceResolver, which a parity test
                                       exists to keep in step -- living in a page nothing tests against the
                                       other two. The row is marked as edited instead. *@
                                    <td class="num">@AdminUi.Money(l.Net, _q.Currency, 2)</td>
                                    <td class="num"><strong>@AdminUi.Money(l.LineTotal, _q.Currency, 2)</strong></td>
                                    <td class="trail">
                                        @* Two-step in the row rather than a dialog: a single red icon in a dense
                                           table is a misclick away from silently dropping a priced line, and a
                                           full-screen modal for one row is heavier than the decision deserves. *@
                                        @if (!CanEditLines)
                                        {
                                            <span class="line-lock" title="Locked by the order this quote became">&mdash;</span>
                                        }
                                        else if (_pendingLine == l.LineId)
                                        {
                                            <span class="line-confirm">
                                                <button type="button" class="btn btn-sm btn-danger-outline"
                                                        disabled="@_removing" @onclick="() => RemoveLine(l)">Remove</button>
                                                <button type="button" class="btn btn-sm btn-secondary"
                                                        disabled="@_removing" @onclick="() => _pendingLine = null">Cancel</button>
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button" class="line-del" disabled="@_removing"
                                                    title="Remove this line" aria-label="@($"Remove {l.Sku}")"
                                                    @onclick="() => _pendingLine = l.LineId">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6M10 11v6M14 11v6"/></svg>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <button class="add-line" @onclick="OpenAddLine">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>Add line item
                </button>
            </div>
        </div>

        <div class="stack">
            <div class="panel panel-pad">
                <div class="kv"><span class="k">Subtotal (net)</span><span class="v-strong">@AdminUi.Money(_sub, _q.Currency, 2)</span></div>
                <div class="kv mt"><span class="k">VAT (23%)</span><span class="v-strong">@AdminUi.Money(_vat, _q.Currency, 2)</span></div>
                <div class="divider"></div>
                <div class="total-row"><span>Total</span><strong>@AdminUi.Money(_total, _q.Currency, 2)</strong></div>
                <div class="autoprice">
                    <span class="autoprice-tag">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.9 4.9l2.8 2.8M16.3 16.3l2.8 2.8M2 12h4M18 12h4"/></svg>Auto-priced
                    </span>
                    <span>Prices reflect the <strong>@_group</strong> group base of -@(_disc)% with per-product overrides. Estimated margin @_marginStr.</span>
                </div>
            </div>

            <div class="panel panel-pad">
                <span class="card-kicker">Quote details</span>
                <div class="kv"><span class="k">Account</span><a class="v" href="admin/accounts">@_q.Account</a></div>
                <div class="kv mt"><span class="k">Customer group</span><span class="v-strong">@_group</span></div>
                <div class="kv mt"><span class="k">Payment</span><span class="v">@_payment · @_terms</span></div>
                <div class="kv mt"><span class="k">Currency</span><span class="v">@_q.Currency</span></div>
                <div class="kv mt"><span class="k">Prepared by</span><span class="v">Órla Doyle</span></div>
                <div class="divider"></div>
                <span class="card-kicker">Status</span>
                @foreach (var s in _steps)
                {
                    <div class="step">
                        <span class="step-dot @(s.Active ? "step-dot--active" : s.Done ? "step-dot--done" : "step-dot--todo")">@s.Mark</span>
                        <span class="step-label @(s.Done ? "on" : null)">@s.Label</span>
                    </div>
                }
            </div>
        </div>
    </div>
}

<Modal Visible="_showAddLine" Title="Add line item" OnClose="() => _showAddLine = false">
    <EditForm Model="_lineDraft" OnValidSubmit="AddLine">
        <div class="modal-body">
            @if (!SelectableProducts.Any())
            {
                <p class="hint">
                    There is no sellable stock in the catalogue yet. Add a product from your own
                    warehouse, or sync a distributor feed, then come back.
                </p>
            }
            else
            {
                <div class="form-grid">
                    <div class="field span2">
                        <label>Product</label>
                        <Combo Options="ProductOptions" Value="@_lineDraft.Sku" ValueChanged="PickProduct"
                               Placeholder="Search by name, SKU or manufacturer"
                               EmptyText="No sellable stock matches that." />
                    </div>

                    <div class="field">
                        <label>Quantity</label>
                        <input class="input" type="number" min="1" max="@StockCeiling"
                               value="@_lineDraft.Qty" @onchange="SetQty" />
                        <span class="field-note @(OverStock ? "field-note--warn" : null)">
                            @QuantityNote
                        </span>
                    </div>

                    <div class="field">
                        <label>Discount %</label>
                        <input class="input" type="number" min="0" max="100"
                               value="@_lineDraft.Disc" @onchange="SetDisc" />
                        <span class="field-note">Defaults to the account's group rate (-@(_disc)%).</span>
                    </div>
                </div>

                @if (PickedProduct is { } picked)
                {
                    <div class="pick-summary">
                        <span class="pick-name">@(string.IsNullOrWhiteSpace(picked.Desc) ? picked.Name : picked.Desc)</span>
                        <span class="pick-facts">
                            <span>@picked.Sku</span>
                            <span>@AdminUi.Money(picked.Price, Cur, 2) each</span>
                            <span class="@(picked.Avail <= 6 ? "pick-low" : null)">
                                @(picked.Source == "Own" ? $"{picked.Avail} in warehouse" : $"{picked.Avail} at {picked.Dist}")
                            </span>
                        </span>
                        <strong class="pick-total">@AdminUi.Money(LineTotal, Cur, 2)</strong>
                    </div>
                }
            }
        </div>
        <div class="modal-foot">
            <button type="button" class="btn btn-secondary" @onclick="() => _showAddLine = false">Close</button>
            <button type="submit" class="btn btn-primary" disabled="@(!CanAddLine)">Add line</button>
        </div>
    </EditForm>
</Modal>

@code {
    [Parameter] public string Id { get; set; } = "";
    [CascadingParameter] public AdminLayout? Layout { get; set; }

    private Quote? _q;
    private string _group = "Reseller", _payment = "Card", _terms = "Prepaid", _marginStr = "0%";
    private int _disc;
    private decimal _sub, _vat, _total;
    private List<Step> _steps = new();

    private record Step(string Label, bool Done, bool Active, string Mark);

    protected override void OnParametersSet()
    {
        _q = Data.GetQuote(Id);
        Layout?.SetPage("Quote", "Build and price a customer quote");
        if (_q is null) return;

        var acc = Data.Accounts.FirstOrDefault(a => a.Company == _q.Account);
        _group = acc?.Group ?? "Reseller";
        _payment = acc?.Payment ?? "Card";
        _terms = acc?.Terms ?? "Prepaid";
        _disc = Data.DiscountFor(_group);
        Recalc();
    }

    private void Recalc()
    {
        // Re-read from the snapshot: a mutation replaces the cached objects, so the instance
        // captured when the page loaded is stale after an API round trip.
        _q = Data.GetQuote(Id);

        if (_q is null) return;
        _sub = _q.LineItems.Sum(l => l.LineTotal);
        _vat = Math.Round(_sub * 0.23m, 2);
        _total = _sub + _vat;
        var cost = _q.LineItems.Sum(l => (Data.GetProduct(l.Sku)?.Cost ?? 0) * l.Qty);
        var margin = _sub > 0 ? (1 - cost / _sub) * 100 : 0;
        _marginStr = margin.ToString("0.0") + "%";

        // Recomputed here rather than in OnParametersSet, because "Send to customer" moves the
        // status from this page: left where it was, the stepper would still read Requested
        // beside a badge reading Priced.
        var cur = _q.Status switch { "Requested" => 0, "Priced" => 1, "Accepted" => 2, "Rejected" => 1, _ => 0 };
        var labels = new[] { "Requested", "Priced", "Accepted" };
        _steps = labels.Select((l, i) => new Step(l, i <= cur, i == cur, i < cur ? "\u2713" : (i + 1).ToString())).ToList();
    }

    private bool _showAddLine;
    private LineDraft _lineDraft = new();

    // Which row is asking to be confirmed, and whether a removal is in flight. Both live here
    // rather than on the line so a refreshed snapshot cannot carry a half-finished prompt.
    private int? _pendingLine;
    private bool _removing;

    /// <summary>
    /// An accepted quote is the record behind an order that has already been raised from it.
    /// Removing a line would leave the two disagreeing about what was sold, so the control is
    /// withdrawn. Adding is left alone: it is not destructive and was never gated.
    /// </summary>
    private bool CanEditLines => _q?.Status != "Accepted";

    private async Task RemoveLine(QuoteLine line)
    {
        _removing = true;
        try
        {
            bool removed = await Data.DeleteQuoteLine(Id, line.LineId);
            _pendingLine = null;
            Recalc();

            Toast.Show(removed
                ? $"{line.Sku} removed from {Id}"
                : "Could not remove the line — reload the quote and try again.");
        }
        finally
        {
            _removing = false;
        }
    }

    private sealed class LineDraft
    {
        public string Sku { get; set; } = "";
        public int Qty { get; set; } = 1;
        public int Disc { get; set; }
    }

    // Only sellable stock can be added: delisted feed products and anything the catalog no
    // longer carries are filtered out.
    private IEnumerable<SMPortal.Models.Product> SelectableProducts =>
        Data.Products.Where(p => p.Avail > 0 || p.Source == "Own");

    // Desc carries the brand and model, Name the spec string, so the brand goes on the primary
    // line where it is scannable and searchable.
    private List<ComboOption> ProductOptions => SelectableProducts
        .Select(p => new ComboOption(
            p.Sku,
            string.IsNullOrWhiteSpace(p.Desc) ? p.Name : p.Desc,
            $"{p.Sku} · {p.Name}",
            p.Avail > 0 ? $"{p.Avail} in stock" : "Backorder"))
        .ToList();

    private SMPortal.Models.Product? PickedProduct =>
        SelectableProducts.FirstOrDefault(p => p.Sku == _lineDraft.Sku);

    /// <summary>
    /// Own-warehouse stock can be back-ordered, so it is not capped. Distributor stock is
    /// somebody else's shelf: quoting more than the feed reports is a promise that cannot be met.
    /// </summary>
    private int StockCeiling =>
        PickedProduct is { Source: not "Own" } p && p.Avail > 0 ? p.Avail : int.MaxValue;

    private bool OverStock => _lineDraft.Qty > StockCeiling;

    private decimal LineTotal => PickedProduct is null
        ? 0m
        : PickedProduct.Price * _lineDraft.Qty * (100 - _lineDraft.Disc) / 100m;

    private string QuantityNote
    {
        get
        {
            if (PickedProduct is null) return "Pick a product first.";
            if (OverStock) return $"Only {StockCeiling} available at {PickedProduct.Dist}.";

            return StockCeiling == int.MaxValue
                ? "Own warehouse — no feed limit."
                : $"{StockCeiling - _lineDraft.Qty} would remain.";
        }
    }

    private string Cur => _q?.Currency ?? "EUR";

    private bool CanAddLine =>
        PickedProduct is not null && _lineDraft.Qty > 0 && !OverStock;

    private void PickProduct(string? sku)
    {
        _lineDraft.Sku = sku ?? "";

        // A quantity left over from a previous, better-stocked pick would otherwise sit there
        // invalid against the new one.
        if (_lineDraft.Qty > StockCeiling)
        {
            _lineDraft.Qty = Math.Max(1, StockCeiling);
        }
    }

    private void SetQty(ChangeEventArgs args)
    {
        var parsed = int.TryParse(args.Value?.ToString(), out var value) ? value : 1;
        _lineDraft.Qty = Math.Clamp(parsed, 1, StockCeiling);
    }

    private void SetDisc(ChangeEventArgs args)
    {
        var parsed = int.TryParse(args.Value?.ToString(), out var value) ? value : 0;
        _lineDraft.Disc = Math.Clamp(parsed, 0, 100);
    }

    private void OpenAddLine()
    {
        // No pre-selection: an operator who misses the picker cannot now add whichever product
        // happened to sort first, which the old default-to-first select made easy.
        _lineDraft = new LineDraft { Disc = _disc };
        _showAddLine = true;
    }

    private async Task AddLine()
    {
        bool added = await Data.AddQuoteLine(Id, _lineDraft.Sku, _lineDraft.Qty, _lineDraft.Disc);
        _showAddLine = false;
        Recalc();

        // Report what actually happened rather than assuming success.
        Toast.Show(added ? "Line item added" : "Could not add the line — pick a product that is in the catalogue.");
    }
    // ---- Re-pricing -------------------------------------------------------------------------

    /// <summary>
    /// Edits waiting to be written, keyed by line id. Held here rather than on the line so a
    /// refreshed snapshot — every mutation replaces it — cannot carry a half-typed number.
    /// </summary>
    private readonly Dictionary<int, LineEdit> _edits = new();

    private sealed record LineEdit(int Qty, decimal Disc);

    private int _editStamp;
    private bool _saving;

    private bool HasEdits => _edits.Count > 0;

    private bool IsEdited(QuoteLine line) => _edits.ContainsKey(line.LineId);

    private int QtyOf(QuoteLine line) =>
        _edits.TryGetValue(line.LineId, out var edit) ? edit.Qty : line.Qty;

    private decimal DiscOf(QuoteLine line) =>
        _edits.TryGetValue(line.LineId, out var edit) ? edit.Disc : line.Disc;

    /// <summary>
    /// Records a pending edit, and drops it again when the value is back to what is stored —
    /// so typing a number and undoing it does not leave a write queued that changes nothing.
    /// </summary>
    private void Stage(QuoteLine line, int qty, decimal disc)
    {
        if (qty == line.Qty && disc == line.Disc)
        {
            _edits.Remove(line.LineId);
            return;
        }

        _edits[line.LineId] = new LineEdit(qty, disc);
    }

    private void SetQty(QuoteLine line, ChangeEventArgs args)
    {
        int parsed = int.TryParse(args.Value?.ToString(), out var value) ? value : line.Qty;

        // Floored at one here and refused below one by the procedure. Not ceilinged: an admin
        // quoting more than a distributor currently reports is a judgement the add-line dialog
        // already lets them make against their own warehouse.
        Stage(line, Math.Max(1, parsed), DiscOf(line));
    }

    private void SetDisc(QuoteLine line, ChangeEventArgs args)
    {
        decimal parsed = decimal.TryParse(args.Value?.ToString(), out var value) ? value : line.Disc;

        // Two places, because QuoteLine.DiscountPct is DECIMAL(5, 2): a floored price's
        // effective discount is not a whole number, and rounding it here would quietly
        // re-price the line the operator was only looking at.
        Stage(line, QtyOf(line), Math.Round(Math.Clamp(parsed, 0m, 100m), 2));
    }

    private async Task SaveDraft()
    {
        if (_q is null || !HasEdits) return;

        _saving = true;
        try
        {
            int written = 0, refused = 0;

            foreach (var (lineId, edit) in _edits.ToList())
            {
                if (await Data.UpdateQuoteLine(Id, lineId, edit.Qty, edit.Disc))
                {
                    written++;
                }
                else
                {
                    refused++;
                }
            }

            _edits.Clear();

            // A new stamp re-keys the inputs, so they pick up the saved values rather than
            // keeping what was typed.
            _editStamp++;
            Recalc();

            Toast.Show(refused == 0
                ? $"{written} line{(written == 1 ? "" : "s")} re-priced on {Id}"
                : $"{written} saved, {refused} could not be — reload {Id} and try again.");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SendQuote()
    {
        if (_q is null) return;

        // Unsaved edits would go out as a price the customer can accept while the operator
        // still has different numbers on screen.
        if (HasEdits)
        {
            Toast.Show("Save the draft first — there are line changes that have not been written.");
            return;
        }

        string account = _q.Account;
        var outcome = await Data.SendQuoteToCustomer(Id);
        Recalc();

        // Three outcomes, like the conversion. "Already decided" is the customer having
        // accepted or rejected it while this screen was open, which is not a failure.
        Toast.Show(outcome switch
        {
            QuotePricing.Sent => $"{Id} sent to {account} — they can accept it now.",
            QuotePricing.AlreadyDecided => $"{Id} has already been decided — nothing was sent.",
            _ => $"Could not send {Id} to the customer."
        });
    }

    private async Task ConvertToOrder()
    {
        if (_q is null) return;

        var conversion = await Data.ConvertQuoteToOrder(_q.Id);

        // Three outcomes. "Already decided" is what an operator sees when the customer
        // accepted the quote themselves a moment earlier, and calling that a failure would
        // send somebody looking for a fault that is not there.
        if (conversion.AlreadyDecided)
        {
            Recalc();
            Toast.Show($"{_q.Id} has already been decided — its order is on the orders screen.");
            return;
        }

        if (!conversion.Succeeded)
        {
            Toast.Show("Could not convert the quote to an order.");
            return;
        }

        Toast.Show($"Order {conversion.Order!.Id} created from {_q.Id}");
        Nav.NavigateTo($"admin/orders/{conversion.Order.Id}");
    }
}

