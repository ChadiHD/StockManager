@page "/admin/groups"
@inject IAdminDataService Data
@inject NavigationManager Nav
@inject IToastService Toast

<PageTitle>Customer groups · StockManager</PageTitle>

<div class="page-head">
    <div><span class="eyebrow">Pricing</span><h1>Customer groups</h1></div>
    <div class="head-actions">
        <button class="btn btn-primary" @onclick="() => _showNew = true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>New group
        </button>
    </div>
</div>

<div class="explainer">
    <svg viewBox="0 0 24 24" fill="none" stroke="#0b8b93" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
    <p>Each group applies a <strong>base discount</strong> off list price to every product. <strong>Per-product overrides</strong> pin specific SKUs to a fixed price or a different margin — these win over the base rate when a quote is priced.</p>
</div>

<div class="panel panel-clip">
    <div class="toolbar">
        <SearchBox Value="@_search" ValueChanged="OnSearch" Busy="_searching" Placeholder="Search group, terms or note" />
        <div class="toolbar-count"><strong>@Results.Count</strong> groups</div>
    </div>
    <BusyOverlay Busy="_searching">
    <div class="tbl-wrap">
        <table class="tbl">
            <thead><tr><th class="lead">Group</th><th class="ctr">Base discount</th><th class="ctr">Accounts</th><th class="ctr">Price overrides</th><th>Terms</th><th class="trail"></th></tr></thead>
            <tbody>
                @foreach (var g in Paged)
                {
                    <tr class="clickable" @onclick='() => Nav.NavigateTo($"admin/groups/{Slug(g.Name)}")'>
                        <td class="lead"><span class="cell-primary">@g.Name</span><span class="cell-sub">@g.Note</span></td>
                        <td class="ctr"><span class="disc-big">-@(g.Discount)<span class="pct">%</span></span></td>
                        <td class="ctr">@g.Accounts</td>
                        <td class="ctr"><span class="ov-chip">@g.Overrides SKUs</span></td>
                        <td>@g.Terms</td>
                        <td class="trail"><button class="btn btn-secondary btn-sm" @onclick:stopPropagation="true" @onclick='() => Nav.NavigateTo($"admin/groups/{Slug(g.Name)}")'>Edit rules</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </BusyOverlay>
    <Pager TotalCount="Results.Count" Page="_page" PageChanged="p => _page = p"
           PageSize="_pageSize" PageSizeChanged="OnPageSizeChanged" />
</div>

<Modal Visible="_showNew" Title="New customer group" OnClose="() => _showNew = false">
    <EditForm Model="_draft" OnValidSubmit="CreateGroup">
        <div class="modal-body">
            <div class="form-grid">
                <div class="field span2">
                    <label>Group name</label>
                    <InputText class="input" @bind-Value="_draft.Name" />
                    <span class="field-note @(NameTaken ? "field-note--warn" : null)">
                        @(NameTaken ? "A group with that name already exists." : "Appears on quotes and account records.")
                    </span>
                </div>
                <div class="field">
                    <label>Base discount (%)</label>
                    <input class="input" type="number" min="0" max="100" value="@_draft.Discount" @onchange="SetDiscount" />
                    <span class="field-note">
                        @(_draft.Discount == 0
                            ? "List price — no reduction."
                            : $"€100 list becomes €{100 - _draft.Discount}.")
                    </span>
                </div>
                <div class="field">
                    <label>Payment terms</label>
                    @* Free text previously, so "Net 30", "net30" and "30 days" all coexisted. *@
                    <InputSelect class="input" @bind-Value="_draft.Terms">
                        @foreach (var t in _termsOptions) { <option>@t</option> }
                    </InputSelect>
                </div>
                <div class="field span2">
                    <label>Description <span class="label-optional">optional</span></label>
                    <InputText class="input" @bind-Value="_draft.Note" />
                </div>
            </div>
        </div>
        <div class="modal-foot">
            <button type="button" class="btn btn-secondary" @onclick="() => _showNew = false">Close</button>
            <button type="submit" class="btn btn-primary" disabled="@(!CanCreateGroup)">Create group</button>
        </div>
    </EditForm>
</Modal>

@code {
    [CascadingParameter] public AdminLayout? Layout { get; set; }
    private bool _showNew;
    private Group _draft = new() { Terms = "Net 30" };

    private readonly string[] _termsOptions = { "Prepaid", "Net 14", "Net 30", "Net 45", "Net 60" };

    private bool NameTaken =>
        !string.IsNullOrWhiteSpace(_draft.Name) &&
        Data.Groups.Any(g => string.Equals(g.Name, _draft.Name, StringComparison.OrdinalIgnoreCase));

    private bool CanCreateGroup => !string.IsNullOrWhiteSpace(_draft.Name) && !NameTaken;

    private void SetDiscount(ChangeEventArgs args) =>
        _draft.Discount = int.TryParse(args.Value?.ToString(), out var value)
            ? Math.Clamp(value, 0, 100)
            : 0;

    private int _page = 1;
    private int _pageSize = 25;

    private string _search = "";
    private readonly SearchCache<Group> _cache = new();

    private List<Group> Results => _cache.Get(
        $"{_search}|{Data.Groups.Count}",
        () => FuzzySearch.Rank(Data.Groups, _search,
            g => new[] { g.Name, g.Terms, g.Note }));

    private IEnumerable<Group> Paged => Results.Skip((_page - 1) * _pageSize).Take(_pageSize);

    private bool _searching;

    // Scoring runs on the single WebAssembly UI thread. Yield once first so the browser can
    // paint the busy overlay before the work starts, rather than the page appearing frozen.
    private async Task OnSearch(string term)
    {
        // Raise the overlay while _search still holds the PREVIOUS term: the memoised cache
        // returns the old results, so this render is cheap and the browser can paint it.
        // Applying the new term first made this very render run the scoring synchronously,
        // which is why the spinner never appeared.
        _searching = true;
        StateHasChanged();

        // Long enough for a paint frame (~16ms); Task.Delay(1) was not.
        await Task.Delay(80);

        _search = term;
        _page = 1;

        // Now do the work, with the overlay already on screen.
        _ = Results.Count;

        _searching = false;
    }

    private void OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _page = 1;
    }

    protected override void OnParametersSet() => Layout?.SetPage("Customer groups", "Pricing tiers and discount rules");

    // Slug keeps group names route-safe (e.g. "Government / Education" -> "government-education").
    public static string Slug(string name) =>
        new string(name.ToLowerInvariant().Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray())
            .Trim('-').Replace("--", "-").Replace("--", "-");

    private async Task CreateGroup()
    {
        await Data.AddGroup(_draft);
        var slug = Slug(_draft.Name);
        _showNew = false;
        _draft = new() { Terms = "Net 30" };
        Toast.Show("Customer group created");
        Nav.NavigateTo($"admin/groups/{slug}");
    }
}
