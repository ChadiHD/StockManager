@page "/admin/reports"
@inject IAdminDataService Data
@inject IToastService Toast
@inject IJSRuntime JS

<PageTitle>Reports · StockManager</PageTitle>

<div class="page-head">
    <div><span class="eyebrow">Performance</span><h1>Reports</h1></div>
    <div class="head-actions">
        <button class="btn btn-secondary" @onclick="ExportCsv">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>Export
        </button>
    </div>
</div>

<div class="filters panel">
    <div class="field"><label>From</label><input type="date" value="2026-07-01" /></div>
    <div class="field"><label>To</label><input type="date" value="2026-08-03" /></div>
    <div class="field grow"><label>Account</label><input placeholder="All accounts" /></div>
</div>

<section class="rep-kpis">
    <div class="rep-kpi">
        <span class="rep-ico rep-ico--ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>
        <div><span class="rep-label">Revenue (EUR)</span><strong class="rep-num">@AdminUi.Money(_revenue, "EUR")</strong><span class="rep-sub">EUR-settled orders</span></div>
    </div>
    <div class="rep-kpi">
        <span class="rep-ico rep-ico--purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M9 14 15 8M9 8h.01M15 15h.01"/></svg></span>
        <div><span class="rep-label">VAT collected</span><strong class="rep-num">@AdminUi.Money(_vat, "EUR")</strong><span class="rep-sub">At 23% standard rate</span></div>
    </div>
    <div class="rep-kpi">
        <span class="rep-ico rep-ico--info"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V4M4 20h16"/><rect x="7" y="11" width="3" height="6"/><rect x="12" y="7" width="3" height="10"/><rect x="17" y="13" width="3" height="4"/></svg></span>
        <div><span class="rep-label">Transactions</span><strong class="rep-num">@Data.Reports.Count</strong><span class="rep-sub">In selected range</span></div>
    </div>
</section>

<div class="panel panel-clip">
    <div class="toolbar">
        <h2 class="tbl-title">Settled sales</h2>
        <SearchBox Value="@_search" ValueChanged="OnSearch" Busy="_searching" Placeholder="Search account or reference" />
        <div class="toolbar-count"><strong>@Results.Count</strong> rows</div>
    </div>
    <BusyOverlay Busy="_searching">
    <div class="tbl-wrap">
        <table class="tbl">
            <thead><tr><th class="lead">Date</th><th>Account</th><th>Reference</th><th class="num">Net</th><th class="num">VAT</th><th class="num trail">Total</th></tr></thead>
            <tbody>
                @foreach (var r in Paged)
                {
                    <tr>
                        <td class="lead cell-sub nowrap">@r.Date</td>
                        <td><span class="cell-strong">@r.Account</span></td>
                        <td class="mono cell-sub">@r.Ref</td>
                        <td class="num">@AdminUi.Money(r.Net, r.Cur)</td>
                        <td class="num cell-sub">@AdminUi.Money(r.Vat, r.Cur)</td>
                        <td class="num trail"><strong>@AdminUi.Money(r.Total, r.Cur)</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </BusyOverlay>
    <Pager TotalCount="Results.Count" Page="_page" PageChanged="p => _page = p"
           PageSize="_pageSize" PageSizeChanged="OnPageSizeChanged" />
</div>

@code {
    [CascadingParameter] public AdminLayout? Layout { get; set; }

    private int _page = 1;
    private int _pageSize = 25;

    private string _search = "";
    private readonly SearchCache<ReportRow> _cache = new();

    private List<ReportRow> Results => _cache.Get(
        $"{_search}|{Data.Reports.Count}",
        () => FuzzySearch.Rank(Data.Reports, _search,
            r => new[] { r.Account },
            r => new[] { r.Ref }));

    private IEnumerable<ReportRow> Paged => Results.Skip((_page - 1) * _pageSize).Take(_pageSize);

    private bool _searching;

    // Scoring runs on the single WebAssembly UI thread. Yield once first so the browser can
    // paint the busy overlay before the work starts, rather than the page appearing frozen.
    private async Task OnSearch(string term)
    {
        // Raise the overlay while _search still holds the PREVIOUS term: the memoised cache
        // returns the old results, so this render is cheap and the browser can paint it.
        // Applying the new term first made this very render run the scoring synchronously,
        // which is why the spinner never appeared.
        _searching = true;
        StateHasChanged();

        // Long enough for a paint frame (~16ms); Task.Delay(1) was not.
        await Task.Delay(80);

        _search = term;
        _page = 1;

        // Now do the work, with the overlay already on screen.
        _ = Results.Count;

        _searching = false;
    }

    private void OnPageSizeChanged(int size)
    {
        _pageSize = size;
        _page = 1;
    }

    private decimal _revenue, _vat;

    protected override void OnParametersSet()
    {
        Layout?.SetPage("Reports", "Sales performance and tax");
        _revenue = Data.Reports.Where(r => r.Cur == "EUR").Sum(r => r.Total);
        _vat = Data.Reports.Where(r => r.Cur == "EUR").Sum(r => r.Vat);
    }

    private async Task ExportCsv()
    {
        var csv = Csv.Build(
            new[] { "Date", "Account", "Reference", "Net", "VAT", "Total" },
            Data.Reports.Select(r => new[] { r.Date, r.Account, r.Ref, r.Net.ToString("0"), r.Vat.ToString("0"), r.Total.ToString("0") }));
        await JS.InvokeVoidAsync("smportal.downloadCsv", "smportal-reports.csv", csv);
        Toast.Show("Reports exported (CSV)");
    }
}
