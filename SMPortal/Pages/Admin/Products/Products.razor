@page "/admin/products"
@inject IAdminDataService Data
@inject NavigationManager Nav
@inject IToastService Toast
@inject IJSRuntime JS
@inject ProductListState State

<PageTitle>Products &amp; stock · StockManager</PageTitle>

<div class="page-head">
    <div><span class="eyebrow">Inventory</span><h1>Products &amp; stock</h1></div>
    <div class="head-actions">
        <button class="btn btn-secondary" @onclick="SyncFeeds">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6M3 12a9 9 0 0 1 15-6.7L21 8M3 22v-6h6M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>Sync feeds
        </button>
        <button class="btn btn-secondary" @onclick="FetchImages" disabled="@_fetchingImages">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>@(_fetchingImages ? "Fetching…" : "Fetch images")
        </button>
        <button class="btn btn-primary" @onclick="() => _showNew = true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>Add product
        </button>
    </div>
</div>

<div class="feed-strip">
    <span class="feed-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2v6h-6M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6M21 12a9 9 0 0 1-15 6.7L3 16"/></svg></span>
    <div class="feed-body"><strong>Distributor feeds</strong><span>@FeedSummary</span></div>
    @if (OutOfDateFeeds > 0)
    {
        <span class="feed-warn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/></svg>@OutOfDateFeeds @AdminUi.Noun(OutOfDateFeeds, "feed", "feeds") out of date
        </span>
    }
</div>

<div class="panel panel-clip">
    <div class="toolbar">
        <div class="pill-row">
            @foreach (var f in _filters)
            {
                <button class="pill @(State.Filter == f ? "pill--active" : null)" @onclick="() => SetFilter(f)">@f</button>
            }
        </div>
        <SearchBox Value="@State.Search" ValueChanged="OnSearch" Busy="_searching" Placeholder="Search name, SKU, MPN, EAN or manufacturer" />
        <div class="toolbar-count"><strong>@Results.Count</strong> @AdminUi.Noun(Results.Count, "product", "products")</div>
    </div>
    @if (_selected.Count > 0)
    {
        @* The bulk half of the per-store choice. Hide, or hand back to the category mapping;
           showing a selection needs a category to file it under, which is the detail page's. *@
        <div class="bulk-bar">
            <span><strong>@_selected.Count</strong> selected</span>
            <button class="btn btn-secondary bulk-hide" disabled="@_bulkBusy" @onclick='() => Bulk("Hide")'>Hide from this store</button>
            <button class="btn btn-secondary bulk-restore" disabled="@_bulkBusy" @onclick="() => Bulk(null)">Follow the category mapping</button>
            <button class="btn btn-secondary" @onclick="_selected.Clear">Clear selection</button>
        </div>
    }
    <BusyOverlay Busy="_searching">
    <div class="tbl-wrap">
        @* tbl--stack: under 720px each row becomes a card, and each cell names itself from its data-label. *@
        <table class="tbl tbl--stack">
            <thead><tr><th class="select-col"><label class="check-hit"><input type="checkbox" aria-label="Select this page" checked="@PageSelected" @onchange="TogglePage" /></label></th><th class="thumb-col"></th><th>Product</th><th>On this store</th><th>Source</th><th class="num">Feed cost</th><th class="num">Sell price</th><th class="trail">Availability</th></tr></thead>
            <tbody>
                @{ var variantCounts = VariantCounts(); }
                @foreach (var p in Paged)
                {
                    <tr class="clickable @(p.Delisted ? "row--delisted" : null)" @onclick='() => Nav.NavigateTo($"admin/products/{p.Sku}")'>
                        <td class="select-col" data-label="Select" @onclick:stopPropagation="true">
                            <label class="check-hit">
                                <input type="checkbox" aria-label="Select @p.Sku" checked="@_selected.Contains(p.Sku)"
                                       @onchange="_ => Toggle(p.Sku)" />
                            </label>
                        </td>
                        <td class="thumb-cell" data-label="Image">
                            @if (string.IsNullOrWhiteSpace(p.Image))
                            {
                                <span class="thumb thumb--none" role="img" aria-label="No image" title="No image">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 2 20 20"/><path d="M7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16"/><path d="M9.5 4h5L17 7h3a2 2 0 0 1 2 2v7.5"/><path d="M14.12 15.12a3 3 0 1 1-4.24-4.24"/></svg>
                                </span>
                            }
                            else
                            {
                                @* The name is in the next cell, so the picture says nothing a reader needs twice. *@
                                <img class="thumb" src="@p.Image" alt="" loading="lazy" />
                            }
                        </td>
                        @* Desc is the brand and model, Name the spec string. Both are needed:
                           two rows can share "LENOVO ThinkPad L14 G2" and differ only in spec. *@
                        <td class="cell-product" data-label="Product">
                            <span class="cell-strong">@(string.IsNullOrWhiteSpace(p.Desc) ? p.Name : p.Desc)</span>
                            <span class="cell-meta">
                                <span class="cell-sub cell-sku mono">@p.Sku</span>
                                @if (variantCounts.TryGetValue(p.Id, out var variants))
                                {
                                    <span class="cell-sub variant-count">@variants @(variants == 1 ? "variant" : "variants")</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(p.Desc))
                                {
                                    <span class="cell-sub cell-name" title="@p.Name">@p.Name</span>
                                }
                            </span>
                        </td>
                        <td class="placement-cell" data-label="On this store">
                            <span class="placement @(p.OnStore ? "placement--on" : "placement--off")">
                                @(p.OnStore ? p.StoreCategory : AdminUi.PlacementLabel(p.Placement))
                            </span>
                            <span class="cell-sub">@(p.OnStore ? AdminUi.PlacementLabel(p.Placement) : $"Feed: {p.Cat}")</span>
                        </td>
                        <td class="src-cell" data-label="Source">
                            <span class="src @AdminUi.SourceClass(p.Source)">@p.Source</span>
                            <span class="cell-sub src-sub" title="@(p.IsDistributor ? $"{p.Dist} · {p.DistSku}" : null)">@(p.IsDistributor ? $"{p.Dist} · {p.DistSku}" : "In-house stock")</span>
                        </td>
                        <td class="num cost-cell" data-label="Feed cost">@AdminUi.Money(p.Cost, Data.CurrentCurrency)</td>
                        <td class="num price-cell" data-label="Sell price"><strong>@AdminUi.Money(p.Price, Data.CurrentCurrency)</strong></td>
                        <td class="trail avail-cell" data-label="Availability">
                            <span class="badge @AdminUi.StatusClass(p.StockKind)" title="@(p.Delisted ? "The distributor no longer supplies it" : null)">@p.StockLabel</span>
                            <span class="sync @(p.Stale ? "sync--stale" : "sync--muted")">@SyncLabel(p)</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </BusyOverlay>
    <Pager TotalCount="Results.Count" Page="State.Page" PageChanged="p => State.Page = p"
           PageSize="State.PageSize" PageSizeChanged="OnPageSizeChanged" />
</div>

<Modal Visible="_showNew" Title="Add product">
    <EditForm Model="_draft" OnValidSubmit="CreateProduct">
        <div class="modal-body">
            <div class="form-grid">
                <div class="field span2">
                    <label>Product name</label>
                    <InputText class="input" @bind-Value="_draft.Name" />
                </div>
                <div class="field">
                    <label>SKU</label>
                    <InputText class="input" @bind-Value="_draft.Sku" />
                    <span class="field-note @(SkuTaken ? "field-note--warn" : null)">
                        @(SkuTaken ? "Already in the catalogue — this would overwrite it." : "Your own reference. Must be unique.")
                    </span>
                </div>
                <div class="field">
                    @* The catalogue category, which each store maps to one of its own. Free
                       text with the existing ones offered, rather than a fixed list: a new value
                       is how an own-stock range gets its own mapping. *@
                    <label>Category</label>
                    <InputText class="input" list="feed-categories" @bind-Value="_draft.Cat" />
                    <datalist id="feed-categories">
                        @foreach (var category in FeedCategories)
                        {
                            <option value="@category"></option>
                        }
                    </datalist>
                    <span class="field-note">A store sells it once this category is mapped, or once it is shown there by hand.</span>
                </div>
                <div class="field">
                    <label>Stock source</label>
                    <InputSelect class="input" @bind-Value="_draft.Source"><option>Own</option><option>Distributor</option></InputSelect>
                </div>
                <div class="field">
                    <label>Available units</label>
                    <input class="input" type="number" min="0" value="@_draft.Avail" @onchange="SetAvail" />
                    <span class="field-note">
                        @(_draft.Avail <= 0 ? "Zero — will show as out of stock." : _draft.Avail <= 6 ? "Counts as low stock." : "In stock.")
                    </span>
                </div>
                <div class="field">
                    <label>Cost (@Data.CurrentCurrency)</label>
                    <input class="input" type="number" min="0" step="0.01" value="@_draft.Cost" @onchange="SetCost" />
                </div>
                <div class="field">
                    <label>Sell price (@Data.CurrentCurrency@(Data.CurrentPricesIncludeTax ? ", incl. tax" : null))</label>
                    <input class="input" type="number" min="0" step="0.01" value="@_draft.Price" @onchange="SetPrice" />
                    <span class="field-note @(NegativeMargin ? "field-note--warn" : null)">@MarginNote</span>
                </div>

                @* Only asked for when they apply: a own-warehouse product has no distributor,
                   and the old form collected both regardless. *@
                @if (_draft.Source == "Distributor")
                {
                    <div class="field">
                        <label>Distributor</label>
                        <InputText class="input" @bind-Value="_draft.Dist" />
                    </div>
                    <div class="field">
                        <label>Distributor SKU</label>
                        <InputText class="input" @bind-Value="_draft.DistSku" />
                        <span class="field-note">Their reference, used to match feed rows.</span>
                    </div>
                }

                <div class="field span2">
                    <label>Description <span class="label-optional">optional</span></label>
                    <InputTextArea class="input" rows="3" @bind-Value="_draft.Desc" />
                </div>
                @if (_draft.Source != "Distributor")
                {
                    <div class="field">
                        <label>Brand <span class="label-optional">optional</span></label>
                        <InputText class="input" @bind-Value="_draft.Manufacturer" />
                    </div>
                }
                <div class="field">
                    <label class="check"><InputCheckbox @bind-Value="_draft.IsTaxable" /> Charge tax on this product</label>
                </div>

                <div class="field span2">
                    <label>Image URL <span class="label-optional">optional</span></label>
                    <InputText class="input" @bind-Value="_draft.Image" />
                    <span class="field-note">Left blank, the Icecat lookup fills it in on the next image fetch.</span>
                </div>
            </div>
        </div>
        <div class="modal-foot">
            <button type="button" class="btn btn-secondary" @onclick="() => _showNew = false">Close</button>
            <button type="submit" class="btn btn-primary" disabled="@(!CanAddProduct)">Add product</button>
        </div>
    </EditForm>
</Modal>

@code {
    [CascadingParameter] public AdminLayout? Layout { get; set; }

    private readonly string[] _filters = { "All", "On this store", "Not on this store", "Own warehouse", "Distributor", "Low stock" };

    private IEnumerable<string> FeedCategories => Data.Products
        .Select(p => p.Cat)
        .Where(cat => !string.IsNullOrWhiteSpace(cat))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(cat => cat);

    // Selection by SKU, so it survives paging and a refresh of the snapshot.
    private readonly HashSet<string> _selected = new(StringComparer.OrdinalIgnoreCase);
    private bool _bulkBusy;
    private int _version;

    private bool PageSelected => Paged.Any() && Paged.All(p => _selected.Contains(p.Sku));

    private void Toggle(string sku)
    {
        if (!_selected.Remove(sku)) _selected.Add(sku);
    }

    private void TogglePage()
    {
        if (PageSelected)
        {
            foreach (var p in Paged) _selected.Remove(p.Sku);
        }
        else
        {
            foreach (var p in Paged) _selected.Add(p.Sku);
        }
    }

    private async Task Bulk(string? visibility)
    {
        _bulkBusy = true;

        try
        {
            var refusal = await Data.SetVisibility(_selected.ToList(), visibility);

            if (refusal is not null)
            {
                Toast.Show(refusal);
                return;
            }

            Toast.Show(visibility == "Hide"
                ? $"{_selected.Count} hidden from this store"
                : $"{_selected.Count} following the category mapping");
            _selected.Clear();
            _version++;
        }
        finally
        {
            _bulkBusy = false;
        }
    }
    private bool _showNew;
    private Product _draft = new();

    // Once per render rather than per row: the snapshot holds every product, and a count per row
    // would read all of them for each one on the page.
    private Dictionary<int, int> VariantCounts() => Data.Products
        .Where(p => p.ParentId is not null)
        .GroupBy(p => p.ParentId!.Value)
        .ToDictionary(group => group.Key, group => group.Count());

    private bool SkuTaken =>
        !string.IsNullOrWhiteSpace(_draft.Sku) &&
        Data.Products.Any(p => string.Equals(p.Sku, _draft.Sku, StringComparison.OrdinalIgnoreCase));

    // Selling under cost is occasionally deliberate (clearing stock) so it warns rather than
    // blocks; a missing name or SKU does block, because the row would be unusable.
    private decimal DraftNet => Data.NetOfTax(_draft.Price, _draft.IsTaxable);

    private bool NegativeMargin => _draft.Price > 0 && _draft.Cost > DraftNet;

    private string MarginNote
    {
        get
        {
            if (_draft.Price <= 0) return "Set a price to see the margin.";
            if (NegativeMargin) return $"Below cost — margin {_draft.MarginPctAt(DraftNet)}%.";

            return _draft.Cost <= 0 ? "No cost recorded." : $"Margin {_draft.MarginPctAt(DraftNet)}%.";
        }
    }

    private bool CanAddProduct =>
        !string.IsNullOrWhiteSpace(_draft.Name) &&
        !string.IsNullOrWhiteSpace(_draft.Sku) &&
        !SkuTaken &&
        (_draft.Source != "Distributor" || !string.IsNullOrWhiteSpace(_draft.Dist));

    private void SetAvail(ChangeEventArgs args) =>
        _draft.Avail = int.TryParse(args.Value?.ToString(), out var value) ? Math.Max(0, value) : 0;

    private void SetCost(ChangeEventArgs args) =>
        _draft.Cost = decimal.TryParse(args.Value?.ToString(), out var value) ? Math.Max(0m, value) : 0m;

    private void SetPrice(ChangeEventArgs args) =>
        _draft.Price = decimal.TryParse(args.Value?.ToString(), out var value) ? Math.Max(0m, value) : 0m;

    // From the store's own feeds. The strip counted distributor names on products as sources and
    // stale products as "feeds out of date" (2647 of them, beside one source), and said "last synced
    // 6 min ago" whatever had happened.
    private int OutOfDateFeeds => Data.Feeds.Count(feed => AdminUi.OutOfDate(feed.LastSyncedUtc));

    private string FeedSummary
    {
        get
        {
            var feeds = Data.Feeds.Count;
            if (feeds == 0) return "None set up for this store";

            var last = Data.Feeds.Max(feed => feed.LastSyncedUtc);
            return $"{feeds} {AdminUi.Noun(feeds, "source", "sources")} · " +
                   (last is null ? "never synced" : $"last synced {last.Value:dd MMM yyyy HH:mm}");
        }
    }

    // Styles and plain products: a variant is listed on its style's page (T11), and a shirt in
    // six sizes is one row here as it is one card in the shop.
    private List<Product> Filtered => Data.Products.Where(p => p.ParentId is null).Where(p => State.Filter switch
    {
        "On this store" => p.OnStore,
        "Not on this store" => !p.OnStore,
        "Own warehouse" => p.Source == "Own",
        "Distributor" => p.Source == "Distributor",
        "Low stock" => !p.Delisted && p.Avail <= 6,
        _ => true
    }).ToList();

    private readonly SearchCache<Product> _cache = new();

    // Desc leads because it holds the brand and model ("LENOVO ThinkPad E14 G2") while Name
    // holds only the spec string — a search for a brand matches on Desc alone.
    private List<Product> Results => _cache.Get(
        // _version because the snapshot is refilled in place: a bulk change leaves the count
        // where it was, and without it the list kept showing what it showed before.
        $"{State.Filter}|{State.Search}|{Data.Products.Count}|{_version}",
        () => FuzzySearch.Rank(Filtered, State.Search,
            p => new[] { p.Desc, p.Name, p.Cat, p.Dist, p.Manufacturer },
            p => new[] { p.Sku, p.DistSku, p.Mpn, p.Ean }));

    private IEnumerable<Product> Paged => Results.Skip((State.Page - 1) * State.PageSize).Take(State.PageSize);

    private bool _searching;

    // Scoring runs on the single WebAssembly UI thread. Yield once first so the browser can
    // paint the busy overlay before the work starts, rather than the page appearing frozen.
    private async Task OnSearch(string term)
    {
        // Raise the overlay while the search still holds the PREVIOUS term: the memoised cache
        // returns the old results, so this render is cheap and the browser can paint it.
        // Applying the new term first made this very render run the scoring synchronously,
        // which is why the spinner never appeared.
        _searching = true;
        StateHasChanged();

        // Long enough for a paint frame (~16ms); Task.Delay(1) was not.
        await Task.Delay(80);

        State.Search = term;
        State.Page = 1;

        // Now do the work, with the overlay already on screen.
        _ = Results.Count;

        _searching = false;
    }

    private bool _fetchingImages;

    // Kicks off one batch now. The background service works through the rest on its own.
    private async Task FetchImages()
    {
        _fetchingImages = true;
        try
        {
            var outcome = await Data.FetchProductImages(100);
            Toast.Show(outcome);
        }
        catch (Exception exception)
        {
            Toast.Show(PlainErrors.Explain(exception, "The image lookup could not be run."));
        }
        finally
        {
            _fetchingImages = false;
        }
    }

    // Changing the filter or page size can leave the current page past the end of the list.
    private void SetFilter(string filter)
    {
        State.Filter = filter;
        State.Page = 1;
    }

    private void OnPageSizeChanged(int size)
    {
        State.PageSize = size;
        State.Page = 1;
    }

    protected override void OnParametersSet()
    {
        Layout?.SetPage("Products & stock", "Own warehouse and distributor-fed inventory");
    }

    private static string SyncLabel(Product p) =>
        p.IsDistributor ? (p.Stale ? "Feed out of date" : "Synced " + p.Synced) : "Own warehouse";

    private async Task CreateProduct()
    {
        await Data.AddProduct(_draft);
        _showNew = false;
        _draft = new();
        Toast.Show("Product added to catalogue");
    }

    private async Task SyncFeeds()
    {
        await Data.SyncFeeds();
        Toast.Show("Distributor feeds synced");
    }
}
