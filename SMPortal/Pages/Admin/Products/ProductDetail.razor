@page "/admin/products/{Sku}"
@inject IAdminDataService Data
@inject NavigationManager Nav
@inject IToastService Toast

<PageTitle>@(_p?.Name ?? Sku) · StockManager</PageTitle>

<button class="back-btn" @onclick='() => Nav.NavigateTo("admin/products")'>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>Back to products
</button>

@if (_p is null)
{
    <div class="panel panel-pad">Product <strong>@Sku</strong> was not found.</div>
}
else
{
    <div class="page-head">
        <div>
            <span class="eyebrow mono">@_p.Sku</span>
            <div class="detail-title"><h1>@_p.Name</h1><span class="badge @AdminUi.StockClass(_p.Avail)">@_p.Avail · @_p.StockKind</span></div>
            <p class="detail-sub">@_p.Cat · @SyncLabel</p>
        </div>
    </div>

    <div class="detail-grid">
        <div class="stack">
            <div class="panel panel-pad overview">
                @if (!string.IsNullOrWhiteSpace(_p.Image))
                {
                    <img class="prod-img" src="@_p.Image" alt="@_p.Name" />
                }
                else
                {
                    <span class="tile tile--lg @AdminUi.CatClass(_p.Cat)">@AdminUi.Initials(_p.Name)</span>
                }
                <div class="overview-body">
                    <span class="src @AdminUi.SourceClass(_p.Source)">@_p.Source</span>
                    <h2>@_p.Name</h2>
                    <p>@_p.Cat · SKU @_p.Sku</p>
                </div>
            </div>

            @if (_p.ParentId is not null)
            {
                @* A variant is its style in one size (T11): spProduct_Update writes only its stock,
                   so the form offers nothing else rather than accepting edits it would discard. *@
                <EditForm Model="_edit" OnValidSubmit="Save" class="panel panel-pad variant-edit">
                    <span class="card-kicker">Variant</span>
                    <p class="field-note">
                        A size or colour of
                        @if (Style is not null)
                        {
                            <a href="@($"admin/products/{Uri.EscapeDataString(Style.Sku)}")">@Style.Name</a>
                        }
                        else
                        {
                            <span>its style</span>
                        }.
                        Its name, price and description are the style's; only its stock is its own.
                    </p>
                    <div class="field"><label>Available units</label><InputNumber class="input" @bind-Value="_edit.Avail" /></div>
                    <button type="submit" class="btn btn-primary mt">Save stock</button>
                </EditForm>
            }
            else
            {
            <EditForm Model="_edit" OnValidSubmit="Save" class="panel panel-pad">
                <span class="card-kicker">Edit product</span>
                <div class="form-grid">
                    <div class="field span2"><label>Product name</label><InputText class="input" @bind-Value="_edit.Name" /></div>
                    @* The feed's category, shown and not edited. It is the string a store's
                       mapping matches; which of a store's categories the product appears under
                       is set per store, in the panel beside this one. *@
                    <div class="field"><label>Feed category</label><span class="input input--readonly feed-category">@(string.IsNullOrWhiteSpace(_p.Cat) ? "None" : _p.Cat)</span></div>
                    <div class="field"><label>Stock source</label><InputSelect class="input" @bind-Value="_edit.Source"><option>Own</option><option>Distributor</option></InputSelect></div>
                    <div class="field"><label>Feed cost (@Data.CurrentCurrency)</label><InputNumber class="input" @bind-Value="_edit.Cost" /></div>
                    <div class="field"><label>Sell price (@Data.CurrentCurrency@(Data.CurrentPricesIncludeTax ? ", incl. tax" : null))</label><InputNumber class="input" @bind-Value="_edit.Price" /></div>
                    <div class="field"><label>Available units</label><InputNumber class="input" @bind-Value="_edit.Avail" /></div>
                    <div class="field"><label>Distributor</label><InputText class="input" @bind-Value="_edit.Dist" /></div>
                    <div class="field"><label>Distributor SKU</label><InputText class="input" @bind-Value="_edit.DistSku" /></div>
                    <div class="field span2"><label>Image URL (optional)</label><InputText class="input" @bind-Value="_edit.Image" /></div>
                    <div class="field span2"><label>Description</label><InputTextArea class="input product-description" rows="4" @bind-Value="_edit.Desc" /></div>
                    @if (!_p.IsDistributor)
                    {
                        @* A feed writes its own brand over a feed product's on every sync, so the
                           field is offered on own stock only, where it sticks (T11). *@
                        <div class="field"><label>Brand</label><InputText class="input" @bind-Value="_edit.Manufacturer" /></div>
                    }
                    <div class="field">
                        <label class="check"><InputCheckbox @bind-Value="_edit.IsTaxable" /> Charge tax on this product</label>
                        <span class="field-note">Untick for goods the store's rules exempt, such as children's clothing in some countries.</span>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt">Save changes</button>
            </EditForm>

            <div class="panel panel-pad product-images">
                <span class="card-kicker">Photographs</span>
                @if (_images.Count == 0)
                {
                    <p class="field-note">None uploaded. The first one becomes the product's image everywhere it is shown.</p>
                }
                else
                {
                    <div class="image-strip">
                        @foreach (var name in _images)
                        {
                            <figure class="image-strip__item">
                                <img src="@($"/img/{name}")" alt="@_p.Name" />
                                <button class="btn btn-ghost btn-sm image-remove" @onclick="() => RemoveImage(name)">Remove</button>
                            </figure>
                        }
                    </div>
                }
                <div class="field mt">
                    <label for="image-upload">Add a photograph <span class="label-optional">JPEG, PNG or WebP, up to 5 MB</span></label>
                    <InputFile id="image-upload" accept=".jpg,.jpeg,.png,.webp" OnChange="UploadImage" disabled="@_uploading" />
                </div>
                @if (_imageError is not null)
                {
                    <p class="field-note field-note--warn image-error">@_imageError</p>
                }
            </div>

            @if (!_p.IsDistributor)
            {
                <div class="panel panel-pad product-variants">
                    <span class="card-kicker">Sizes and colours</span>
                    @if (_variants.Count == 0)
                    {
                        <p class="field-note">None. Add one and the product is sold in that size or colour only, each with its own SKU and stock.</p>
                    }
                    else
                    {
                        <table class="table variant-table">
                            <thead><tr><th>Variant</th><th>SKU</th><th class="num">Stock</th><th class="trail"><span class="vh">Remove</span></th></tr></thead>
                            <tbody>
                                @foreach (var variant in _variants)
                                {
                                    <tr>
                                        <td>@variant.Label</td>
                                        <td class="mono"><a href="@($"admin/products/{Uri.EscapeDataString(variant.Sku)}")">@variant.Sku</a></td>
                                        <td class="num">@variant.Avail</td>
                                        <td class="trail"><button class="btn btn-ghost btn-sm variant-remove" @onclick="() => RemoveVariant(variant.Sku)">Remove</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    <div class="form-grid mt variant-add">
                        <div class="field"><label for="variant-sku">SKU</label><input id="variant-sku" class="input" @bind="_variantSku" /></div>
                        <div class="field"><label for="variant-stock">Stock</label><input id="variant-stock" class="input" type="number" min="0" @bind="_variantStock" /></div>
                        <div class="field"><label for="variant-name-1">Option</label><input id="variant-name-1" class="input" placeholder="Size" @bind="_option1Name" /></div>
                        <div class="field"><label for="variant-value-1">Value</label><input id="variant-value-1" class="input" placeholder="M" @bind="_option1Value" /></div>
                        <div class="field"><label for="variant-name-2">Second option <span class="label-optional">optional</span></label><input id="variant-name-2" class="input" placeholder="Colour" @bind="_option2Name" /></div>
                        <div class="field"><label for="variant-value-2">Value</label><input id="variant-value-2" class="input" placeholder="Navy" @bind="_option2Value" /></div>
                    </div>
                    @if (_variantError is not null)
                    {
                        <p class="field-note field-note--warn variant-error">@_variantError</p>
                    }
                    <button class="btn btn-secondary mt variant-save" @onclick="AddVariant">Add variant</button>
                </div>
            }
            }
        </div>

        <div class="stack">
            <div class="panel panel-pad store-placement">
                <span class="card-kicker">On this store</span>
                <p class="placement-status @(_p.OnStore ? "placement-status--on" : "placement-status--off")">
                    @AdminUi.PlacementLabel(_p.Placement)@(string.IsNullOrWhiteSpace(_p.StoreCategory) ? "" : $" · {_p.StoreCategory}")
                </p>
                <div class="field">
                    <label for="placement-visibility">Visibility</label>
                    <select id="placement-visibility" class="input" @bind="_visibility">
                        <option value="">Follow the category mapping</option>
                        <option value="Show">Show on this store</option>
                        <option value="Hide">Hide from this store</option>
                    </select>
                </div>
                @if (_visibility == "Show")
                {
                    <div class="field mt">
                        <label for="placement-category">List under</label>
                        <select id="placement-category" class="input" @bind="_categoryId">
                            <option value="">Where the mapping files it</option>
                            @foreach (var category in _categories.Where(c => c.IsActive))
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                    </div>
                }
                <div class="field mt">
                    <label for="placement-badge">Badge <span class="label-optional">optional</span></label>
                    <input id="placement-badge" class="input" maxlength="40" @bind="_badge" placeholder="New, Best seller…" />
                </div>
                <label class="check mt"><input type="checkbox" @bind="_featured" /> Featured on this store</label>
                @if (_placementError is not null)
                {
                    <p class="field-note field-note--warn placement-error">@_placementError</p>
                }
                <button class="btn btn-secondary mt placement-save" @onclick="SavePlacement" disabled="@_savingPlacement">Save for this store</button>
            </div>
            <div class="panel panel-pad">
                <span class="card-kicker">Pricing</span>
                <div class="kv"><span class="k">Feed cost</span><span class="v-strong">@AdminUi.Money(_p.Cost, Data.CurrentCurrency)</span></div>
                <div class="kv mt"><span class="k">Sell price</span><span class="v-strong">@AdminUi.Money(_p.Price, Data.CurrentCurrency)</span></div>
                <div class="kv mt"><span class="k">Gross margin</span><span class="v accent">@_p.MarginPctAt(Data.NetOfTax(_p.Price, _p.IsTaxable))%</span></div>
                <div class="divider"></div>
                <div class="kv"><span class="k">Availability</span><span class="badge @AdminUi.StockClass(_p.Avail)">@_p.Avail · @_p.StockKind</span></div>
            </div>
            <div class="panel panel-pad">
                <span class="card-kicker">Stock source</span>
                <div class="kv"><span class="k">Source</span><span class="src @AdminUi.SourceClass(_p.Source)">@_p.Source</span></div>
                <div class="kv mt"><span class="k">Distributor</span><span class="v">@(_p.IsDistributor ? _p.Dist : "\u2014")</span></div>
                <div class="kv mt"><span class="k">Their SKU</span><span class="v mono">@(_p.IsDistributor ? _p.DistSku : "\u2014")</span></div>
                <div class="kv mt"><span class="k">Feed status</span><span class="v">@SyncLabel</span></div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Sku { get; set; } = "";
    [CascadingParameter] public AdminLayout? Layout { get; set; }

    private Product? _p;
    private Product _edit = new();

    // The store-placement form. Strings because a <select> binds strings, and "" is the
    // "follow the mapping" / "where the mapping files it" choice.
    private string _visibility = "";
    private string _categoryId = "";
    private string _badge = "";
    private bool _featured;
    private string? _placementError;
    private bool _savingPlacement;
    private IReadOnlyList<StoreCategoryOption> _categories = [];

    private IReadOnlyList<string> _images = [];
    private string? _imageError;
    private bool _uploading;

    private IReadOnlyList<VariantItem> _variants = [];
    private string _variantSku = "", _option1Name = "", _option1Value = "", _option2Name = "", _option2Value = "";
    private int _variantStock;
    private string? _variantError;

    private Product? Style => _p?.ParentId is { } parentId ? Data.Products.FirstOrDefault(p => p.Id == parentId) : null;

    private string SyncLabel => _p is null ? "" :
        (_p.IsDistributor ? (_p.Stale ? "Feed out of date" : "Synced " + _p.Synced) : "Own warehouse");

    protected override async Task OnParametersSetAsync()
    {
        _p = Data.GetProduct(Sku);
        Layout?.SetPage("Product", "Catalogue item detail and pricing");
        if (_p is null) return;

        // Everything the form does not edit is copied too, because the save sends it all back:
        // leaving Desc, Cat or IsTaxable out is how a save wiped a description, rewrote a feed
        // category and made an exempt product taxable.
        _edit = new()
        {
            Id = _p.Id, ParentId = _p.ParentId,
            Sku = _p.Sku, Name = _p.Name, Cat = _p.Cat, Desc = _p.Desc, IsTaxable = _p.IsTaxable,
            Source = _p.Source, Cost = _p.Cost, Price = _p.Price, Avail = _p.Avail,
            Dist = _p.Dist, DistSku = _p.DistSku, Image = _p.Image,
            // spProduct_Update writes the brand since T11, so it has to come back too.
            Manufacturer = _p.Manufacturer
        };

        LoadPlacement(_p);

        _categories = (await Data.GetCategoryMappings()).Categories;

        // Per product and fetched on opening it, the GetContacts precedent: the snapshot holds every
        // product, and a style's variants and photographs are this page's question (T11).
        _images = _p.ParentId is null ? await Data.GetImages(Sku) : [];
        _variants = _p.ParentId is null && !_p.IsDistributor ? await Data.GetVariants(Sku) : [];
    }

    private void LoadPlacement(Product product)
    {
        _visibility = product.Visibility ?? "";
        _categoryId = product.OverrideCategoryId?.ToString() ?? "";
        _badge = product.Badge;
        _featured = product.Featured;
        _placementError = null;
    }

    private async Task Save()
    {
        await Data.UpdateProduct(_edit);
        _p = Data.GetProduct(Sku);
        Toast.Show("Product saved");
    }

    private async Task AddVariant()
    {
        var options = new List<(string Name, string Value)>();
        if (!string.IsNullOrWhiteSpace(_option1Name)) options.Add((_option1Name.Trim(), _option1Value.Trim()));
        if (!string.IsNullOrWhiteSpace(_option2Name)) options.Add((_option2Name.Trim(), _option2Value.Trim()));

        // The API refuses these too; saying so here spares a round trip for the obvious ones.
        if (string.IsNullOrWhiteSpace(_variantSku) || options.Count == 0 || options.Any(option => option.Value.Length == 0))
        {
            _variantError = "A variant needs a SKU and at least one option with a value, such as Size: M.";
            return;
        }

        _variantError = await Data.AddVariant(Sku, _variantSku.Trim(), _variantStock, options);
        if (_variantError is not null) return;

        _variantSku = _option1Value = _option2Value = "";
        _variantStock = 0;
        _variants = await Data.GetVariants(Sku);
        _p = Data.GetProduct(Sku);
        Toast.Show("Variant added");
    }

    private async Task RemoveVariant(string sku)
    {
        _variantError = await Data.RemoveVariant(sku);
        if (_variantError is not null) return;

        _variants = await Data.GetVariants(Sku);
        _p = Data.GetProduct(Sku);
        Toast.Show("Variant removed");
    }

    private async Task UploadImage(InputFileChangeEventArgs e)
    {
        _imageError = null;

        // The API's own limit, checked first so a large file is refused before it is sent.
        const long maxBytes = 5 * 1024 * 1024;
        if (e.File.Size > maxBytes)
        {
            _imageError = "A photograph can be at most 5 MB.";
            return;
        }

        _uploading = true;

        try
        {
            await using var content = e.File.OpenReadStream(maxBytes);
            _imageError = await Data.UploadImage(Sku, content, e.File.Name);
            if (_imageError is not null) return;

            _images = await Data.GetImages(Sku);
            _p = Data.GetProduct(Sku);
            Toast.Show("Photograph added");
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task RemoveImage(string storedName)
    {
        await Data.RemoveImage(Sku, storedName);
        _images = await Data.GetImages(Sku);
        _p = Data.GetProduct(Sku);
        Toast.Show("Photograph removed");
    }

    private async Task SavePlacement()
    {
        _savingPlacement = true;

        try
        {
            _placementError = await Data.SetPlacement(
                Sku,
                _visibility == "" ? null : _visibility,
                int.TryParse(_categoryId, out var id) ? id : null,
                _featured,
                string.IsNullOrWhiteSpace(_badge) ? null : _badge.Trim());

            if (_placementError is not null) return;

            // Re-read: the snapshot was refreshed, and the object captured on load is stale.
            _p = Data.GetProduct(Sku);
            if (_p is not null) LoadPlacement(_p);
            Toast.Show("Saved for this store");
        }
        finally
        {
            _savingPlacement = false;
        }
    }
}
