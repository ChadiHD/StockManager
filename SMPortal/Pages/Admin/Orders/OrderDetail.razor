@page "/admin/orders/{Id}"
@inject IAdminDataService Data
@inject NavigationManager Nav
@inject IToastService Toast

<PageTitle>Order @Id · StockManager</PageTitle>

<button class="back-btn" @onclick='() => Nav.NavigateTo("admin/orders")'>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>Back to orders
</button>

@if (_o is null)
{
    <div class="panel panel-pad">Order <strong>@Id</strong> was not found.</div>
}
else
{
    <div class="page-head">
        <div>
            <span class="eyebrow">Order @_o.Id</span>
            <div class="detail-title"><h1>@_o.Account</h1><span class="badge @AdminUi.StatusClass(_o.Status)">@_o.Status</span></div>
            <p class="detail-sub">Placed @_o.Placed · @_o.Items items · Sourced from @_o.From</p>
        </div>
        <div class="head-actions">
            <button class="btn btn-secondary" @onclick="() => _showSlip = true">Packing slip</button>
            @if (_o.Status != "Cancelled")
            {
                @* Cancelling an order from the cart gives its stock back (T12). *@
                <button class="btn btn-secondary order-cancel" @onclick="() => SetStatus(OrderStatusCancelled)">Cancel order</button>
            }
            @if (_delivery.Length > 0 && _o.Status is not ("Fulfilled" or "Cancelled"))
            {
                @* A cart order ships to its customer (T13), who is mailed the tracking number. *@
                <input id="order-tracking" class="input order-tracking" placeholder="Tracking number" aria-label="Tracking number" @bind="_tracking" />
            }
            <button class="btn btn-primary" @onclick="() => SetStatus(OrderStatusFulfilled)">Mark fulfilled</button>
        </div>
    </div>

    <div class="detail-grid">
        <div class="stack">
            <div class="panel panel-clip">
                <div class="lines-head"><span class="card-kicker">Order lines</span><h2>Items</h2></div>
                <div class="tbl-wrap">
                    <table class="tbl">
                        <thead><tr><th class="lead">Item</th><th class="ctr">Qty</th><th class="num">Unit price</th><th class="num trail">Line total</th></tr></thead>
                        <tbody>
                            @foreach (var l in _o.LineItems)
                            {
                                <tr>
                                    <td class="lead"><span class="cell-strong">@l.Name</span><span class="cell-sub mono">@l.Sku</span></td>
                                    <td class="ctr">@l.Qty</td>
                                    <td class="num">@AdminUi.Money(l.Price, _o.Currency, 2)</td>
                                    <td class="num trail"><strong>@AdminUi.Money(l.LineTotal, _o.Currency, 2)</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="totals">
                    @if (_o.ShippingName is not null)
                    {
                        @* Informational, on the store's basis: already in the net and the tax below. *@
                        <div class="kv"><span class="k">Delivery · @_o.ShippingName</span><span class="v">@AdminUi.Money(_o.Shipping, _o.Currency, 2)</span></div>
                    }
                    <div class="kv"><span class="k">Subtotal (net)</span><span class="v-strong">@AdminUi.Money(_sub, _o.Currency, 2)</span></div>
                    @* The treatment rather than a hardcoded rate: this store's standard rate
                       is a Site column, and a reverse-charged or exported order is taxed at
                       nothing for a reason worth naming on the screen an admin answers
                       questions from. *@
                    <div class="kv mt">
                        <span class="k">@(string.IsNullOrWhiteSpace(_o.TaxTreatment) ? "Tax" : _o.TaxTreatment)</span>
                        <span class="v-strong">@AdminUi.Money(_vat, _o.Currency, 2)</span>
                    </div>
                    <div class="divider"></div>
                    <div class="total-row"><span>Total</span><strong>@AdminUi.Money(_total, _o.Currency, 2)</strong></div>
                    @if (!string.IsNullOrWhiteSpace(_o.TaxLegend))
                    {
                        <p class="tax-legend">@_o.TaxLegend</p>
                    }
                </div>
            </div>
        </div>

        <div class="stack">
            <div class="panel panel-pad">
                <span class="card-kicker">Fulfilment</span>
                @foreach (var s in _steps)
                {
                    <div class="step">
                        <span class="step-dot @(s.Done ? "step-dot--done" : s.Active ? "step-dot--active" : "step-dot--todo")">@s.Mark</span>
                        <span class="step-label @(s.Done || s.Active ? "on" : null)">@s.Label</span>
                    </div>
                }
            </div>
            @if (_o.FiscalStatus is not null)
            {
                @* The invoice a tax authority must see (T14), from the store's issuer. A failed one
                   is still owed, so it can be sent again once the cause is fixed. *@
                <div class="panel panel-pad order-fiscal">
                    <span class="card-kicker">Fiscal document</span>
                    <div class="kv"><span class="k">Status</span><span class="v order-fiscal-status">@FiscalLabel(_o.FiscalStatus)</span></div>
                    @if (_o.FiscalNumber is not null)
                    {
                        <div class="kv mt"><span class="k">Number</span><span class="v mono order-fiscal-number">@_o.FiscalNumber</span></div>
                    }
                    @* Only an https link: the address is the issuer's answer, and a javascript: one
                       would run in the portal's origin. *@
                    @if (_o.FiscalUrl?.StartsWith("https://", StringComparison.OrdinalIgnoreCase) == true)
                    {
                        <div class="kv mt"><span class="k">Document</span><a class="v" href="@_o.FiscalUrl" target="_blank" rel="noopener noreferrer">Open</a></div>
                    }
                    @if (_o.FiscalStatus == "DeadLettered")
                    {
                        <p class="field-note field-note--warn order-fiscal-error">@_o.FiscalError</p>
                        <button class="btn btn-secondary order-fiscal-retry" @onclick="RetryFiscal">Retry</button>
                    }
                </div>
            }
            <div class="panel panel-pad">
                <span class="card-kicker">Order details</span>
                <div class="kv"><span class="k">Account</span><a class="v" href="admin/accounts">@_o.Account</a></div>
                <div class="kv mt"><span class="k">Source quote</span><span class="v">@_o.From</span></div>
                <div class="kv mt"><span class="k">Currency</span><span class="v">@_o.Currency</span></div>
                <div class="kv mt"><span class="k">Placed</span><span class="v">@_o.Placed</span></div>
                <div class="divider"></div>
                <span class="card-kicker">Ship to</span>
                @* The address the checkout snapshotted (T12). An order from a quote has none on
                   it, and the page says so rather than inventing one. *@
                @if (_delivery.Length == 0)
                {
                    <p class="ship">No delivery address on this order.</p>
                }
                else
                {
                    <p class="ship">@foreach (var line in _delivery) { @line<br /> }</p>
                    @if (_o.TrackingNumber is not null)
                    {
                        <p class="ship">Tracking <span class="mono">@_o.TrackingNumber</span></p>
                    }
                }
            </div>
        </div>
    </div>

    <Modal Visible="_showSlip" Title="Packing slip" OnClose="() => _showSlip = false">
        <div class="modal-body">
            <div class="slip-head"><strong>@_o.Id</strong><span>@_o.Placed</span></div>
            <p class="slip-acc">@_o.Account</p>
            <table class="tbl slip-tbl">
                <thead><tr><th>Item</th><th class="num">Qty</th></tr></thead>
                <tbody>
                    @foreach (var l in _o.LineItems)
                    {
                        <tr><td><span class="cell-strong">@l.Name</span><span class="cell-sub mono">@l.Sku</span></td><td class="num"><strong>@l.Qty</strong></td></tr>
                    }
                </tbody>
            </table>
            <p class="hint">Ship to @(_delivery.Length == 0 ? _o.Account : string.Join(", ", _delivery))</p>
        </div>
        <div class="modal-foot">
            <button type="button" class="btn btn-secondary" @onclick="() => _showSlip = false">Close</button>
        </div>
    </Modal>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    [CascadingParameter] public AdminLayout? Layout { get; set; }

    private Order? _o;
    private bool _showSlip;
    private decimal _sub, _vat, _total;
    private List<Step> _steps = new();

    private record Step(string Label, bool Done, bool Active, string Mark);

    private string[] _delivery = [];
    private string? _tracking;

    protected override async Task OnParametersSetAsync()
    {
        _o = Data.GetOrder(Id);
        Layout?.SetPage("Order", "Order detail and fulfilment");
        if (_o is null) return;
        Recalc();
        _delivery = await Data.GetDeliveryAddress(Id) ?? [];
    }

    private void Recalc()
    {
        // Re-read from the snapshot: a mutation replaces the cached objects, so the instance
        // captured when the page loaded is stale after an API round trip.
        _o = Data.GetOrder(Id);

        if (_o is null) return;
        // Read, not recomputed. Until T6 this page multiplied the net by a hardcoded 0.23
        // while spOrder_ConvertFromQuote stored zero, so an admin saw a total 23% above the
        // one on the customer's own copy of the same order. The rate is per site now, and
        // the figure the document shows is the figure the order carries.
        _sub = _o.SubTotal;
        _vat = _o.Vat;
        _total = _sub + _vat;

        var cancelled = _o.Status == "Cancelled";
        var raw = new (string Label, bool Done)[]
        {
            ("Order placed", true),
            ("Payment confirmed", _o.Status is not ("Awaiting payment" or "Cancelled")),
            ("Picking & packing", _o.Status == "Fulfilled"),
            ("Shipped & invoiced", _o.Status == "Fulfilled"),
        };
        var active = Array.FindIndex(raw, r => !r.Done);
        if (active < 0) active = raw.Length - 1;
        _steps = raw.Select((r, i) => new Step(
            r.Label,
            r.Done,
            !cancelled && i == active && !r.Done,
            r.Done ? "\u2713" : (i + 1).ToString())).ToList();
    }

    private const string OrderStatusCancelled = "Cancelled";
    private const string OrderStatusFulfilled = "Fulfilled";

    private async Task SetStatus(string status)
    {
        if (_o is null) return;

        var id = _o.Id;
        var refused = await Data.SetOrderStatus(id, status, status == OrderStatusFulfilled ? _tracking : null);
        Recalc();

        if (refused is not null)
        {
            Toast.Show(refused);
            return;
        }

        Toast.Show(status == OrderStatusCancelled ? $"Order {id} cancelled" : $"Order {id} marked fulfilled");
    }

    private static string FiscalLabel(string status) => status switch
    {
        "Issued" => "Issued",
        "DeadLettered" => "Failed",
        _ => "Waiting to be issued",
    };

    private async Task RetryFiscal()
    {
        if (_o is null) return;

        var id = _o.Id;
        var refused = await Data.RetryFiscalDocument(id);
        Recalc();

        Toast.Show(refused ?? $"The fiscal document for {id} will be issued again");
    }
}
