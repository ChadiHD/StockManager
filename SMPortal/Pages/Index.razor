@page "/"
@page "/index"
@attribute [Authorize]
@inject IProductEndpoint ProductEndpoint
@inject IInventoryEndpoint InventoryEndpoint
@inject IPurchaseEndpoint PurchaseEndpoint

<PageTitle>Dashboard | StockManager</PageTitle>

<header class="page-header">
    <div>
        <span class="eyebrow">Operational overview</span>
        <h1>Dashboard</h1>
        <p>Live information available to your account from the StockManager API.</p>
    </div>
    <button class="button secondary" @onclick="LoadData" disabled="@isLoading">Refresh data</button>
</header>

@if (isLoading)
{
    <div class="loading-grid" role="status" aria-label="Loading dashboard">
        @for (var index = 0; index < 4; index++)
        {
            <div class="skeleton metric-skeleton"></div>
        }
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert warning" role="alert">
            <strong>Some dashboard data is unavailable.</strong>
            <span>@errorMessage</span>
        </div>
    }

    <section class="metric-grid" aria-label="Key metrics">
        @if (canViewProducts)
        {
            <article class="metric-card">
                <span class="metric-icon teal" aria-hidden="true">P</span>
                <div><span>Active products</span><strong>@products.Count</strong><small>Available to sales staff</small></div>
            </article>
            <article class="metric-card">
                <span class="metric-icon amber" aria-hidden="true">!</span>
                <div><span>Low stock products</span><strong>@products.Count(product => product.QuantityInStock <= 5)</strong><small>Five units or fewer</small></div>
            </article>
        }
        @if (canViewInventory)
        {
            <article class="metric-card">
                <span class="metric-icon blue" aria-hidden="true">I</span>
                <div><span>Inventory records</span><strong>@inventory.Count</strong><small>@inventory.Sum(item => item.Quantity).ToString("N0") units received</small></div>
            </article>
            <article class="metric-card">
                <span class="metric-icon teal" aria-hidden="true">$</span>
                <div><span>Purchase value</span><strong>@inventory.Sum(item => item.PurchasePrice * item.Quantity).ToString("C0")</strong><small>Recorded acquisition cost</small></div>
            </article>
        }
        @if (canViewReports)
        {
            <article class="metric-card">
                <span class="metric-icon purple" aria-hidden="true">R</span>
                <div><span>Recorded sales</span><strong>@reports.Count</strong><small>@reports.Sum(report => report.FinalPrice).ToString("C0") total revenue</small></div>
            </article>
        }
    </section>

    <section class="dashboard-grid">
        <article class="panel">
            <div class="panel-heading">
                <div><span class="eyebrow">Attention</span><h2>Operational focus</h2></div>
            </div>
            @if (canViewProducts)
            {
                var lowStock = products.OrderBy(product => product.QuantityInStock).Take(5).ToList();
                @if (lowStock.Count == 0)
                {
                    <div class="empty-state compact"><strong>No product data</strong><span>No products were returned by the API.</span></div>
                }
                else
                {
                    <div class="compact-list">
                        @foreach (var product in lowStock)
                        {
                            <div>
                                <span class="product-avatar" aria-hidden="true">@product.ProductName.FirstOrDefault()</span>
                                <span><strong>@product.ProductName</strong><small>Product @product.Id</small></span>
                                <span class="status-badge @(product.QuantityInStock <= 5 ? "danger" : "success")">
                                    @product.QuantityInStock in stock
                                </span>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="empty-state compact">
                    <strong>Role-specific workspace</strong>
                    <span>Use the navigation to access the inventory, reporting, or administration tools available to you.</span>
                </div>
            }
        </article>

        <article class="panel">
            <div class="panel-heading">
                <div><span class="eyebrow">Recent activity</span><h2>Latest sales</h2></div>
                @if (canViewReports)
                {
                    <a href="/reports">View report</a>
                }
            </div>
            @if (!canViewReports)
            {
                <div class="empty-state compact"><strong>Reporting access required</strong><span>Sales activity is available to managers and administrators.</span></div>
            }
            else if (reports.Count == 0)
            {
                <div class="empty-state compact"><strong>No sales recorded</strong><span>Completed purchases will appear here.</span></div>
            }
            else
            {
                <div class="compact-list">
                    @foreach (var report in reports.OrderByDescending(report => report.PurchaseDate).Take(5))
                    {
                        <div>
                            <span class="product-avatar neutral" aria-hidden="true">S</span>
                            <span><strong>@report.PurchaseDate.ToString("dd MMM yyyy, HH:mm")</strong><small>@GetOperator(report)</small></span>
                            <strong>@report.FinalPrice.ToString("C")</strong>
                        </div>
                    }
                </div>
            }
        </article>
    </section>
}

@code {
    [CascadingParameter] public Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private readonly List<ProductModel> products = new();
    private readonly List<InventoryModel> inventory = new();
    private readonly List<PurchaseReportModel> reports = new();
    private bool isLoading = true;
    private bool canViewProducts;
    private bool canViewInventory;
    private bool canViewReports;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationStateTask).User;
        canViewProducts = user.IsInRole("Staff");
        canViewInventory = user.IsInRole("Admin") || user.IsInRole("Manager");
        canViewReports = canViewInventory;
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        errorMessage = string.Empty;
        products.Clear();
        inventory.Clear();
        reports.Clear();

        try
        {
            var requests = new List<Task>();
            if (canViewProducts)
            {
                requests.Add(LoadProducts());
            }
            if (canViewInventory)
            {
                requests.Add(LoadInventory());
            }
            if (canViewReports)
            {
                requests.Add(LoadReports());
            }
            await Task.WhenAll(requests);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadProducts() => products.AddRange(await ProductEndpoint.GetAll());
    private async Task LoadInventory() => inventory.AddRange(await InventoryEndpoint.GetAll());
    private async Task LoadReports() => reports.AddRange(await PurchaseEndpoint.GetPurchaseReport());

    private static string GetOperator(PurchaseReportModel report)
    {
        var name = $"{report.FirstName} {report.LastName}".Trim();
        return string.IsNullOrWhiteSpace(name) ? report.EmailAddress : name;
    }
}
