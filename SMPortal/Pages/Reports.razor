@page "/reports"
@attribute [Authorize(Roles = "Admin,Manager")]
@inject IPurchaseEndpoint PurchaseEndpoint

<PageTitle>Sales reports | StockManager</PageTitle>

<header class="page-header">
	<div><span class="eyebrow">Performance</span><h1>Sales reports</h1><p>Review completed sales, tax collected, revenue, and operator activity.</p></div>
	<button class="button secondary" @onclick="LoadReports" disabled="@isLoading">Refresh report</button>
</header>

<section class="panel filter-panel">
	<div class="form-grid report-filters">
		<div class="field"><label for="from-date">From</label><InputDate id="from-date" @bind-Value="fromDate" /></div>
		<div class="field"><label for="to-date">To</label><InputDate id="to-date" @bind-Value="toDate" /></div>
		<div class="field search-field"><label for="operator-search">Operator</label><InputText id="operator-search" @bind-Value="operatorSearch" @bind-Value:event="oninput" placeholder="Name or email" /></div>
	</div>
</section>

<section class="metric-grid compact-metrics" aria-label="Sales summary">
	<article class="metric-card"><span class="metric-icon blue">S</span><div><span>Sales</span><strong>@FilteredReports.Count</strong><small>Matching transactions</small></div></article>
	<article class="metric-card"><span class="metric-icon teal">$</span><div><span>Revenue</span><strong>@FilteredReports.Sum(report => report.FinalPrice).ToString("C0")</strong><small>Final sale value</small></div></article>
	<article class="metric-card"><span class="metric-icon purple">T</span><div><span>Tax collected</span><strong>@FilteredReports.Sum(report => report.VAT).ToString("C0")</strong><small>VAT total</small></div></article>
</section>

<section class="panel">
	<div class="panel-heading"><div><span class="eyebrow">Transactions</span><h2>Sales activity</h2></div><span class="muted">@FilteredReports.Count results</span></div>
	@if (isLoading)
	{
		<div class="route-state" role="status"><span class="spinner"></span><strong>Loading sales report</strong></div>
	}
	else if (!string.IsNullOrWhiteSpace(errorMessage))
	{
		<div class="alert error" role="alert"><strong>The report could not be loaded.</strong><span>@errorMessage</span></div>
	}
	else if (FilteredReports.Count == 0)
	{
		<div class="empty-state"><strong>No matching sales</strong><span>Adjust the date range or operator filter.</span></div>
	}
	else
	{
		<div class="table-wrap"><table>
			<thead><tr><th>Date</th><th>Operator</th><th>Subtotal</th><th>VAT</th><th>Final price</th></tr></thead>
			<tbody>@foreach (var report in FilteredReports)
			{
				<tr><td data-label="Date">@report.PurchaseDate.ToString("dd MMM yyyy, HH:mm")</td><td data-label="Operator"><span class="table-primary">@GetOperator(report)</span><small>@report.EmailAddress</small></td><td data-label="Subtotal">@report.SubTotal.ToString("C")</td><td data-label="VAT">@report.VAT.ToString("C")</td><td data-label="Final price"><strong>@report.FinalPrice.ToString("C")</strong></td></tr>
			}</tbody>
		</table></div>
	}
</section>

@code {
	private readonly List<PurchaseReportModel> reports = new();
	private DateTime fromDate = DateTime.Today.AddMonths(-1);
	private DateTime toDate = DateTime.Today;
	private string operatorSearch = string.Empty;
	private string errorMessage = string.Empty;
	private bool isLoading = true;

	private List<PurchaseReportModel> FilteredReports => reports
		.Where(report => report.PurchaseDate.Date >= fromDate.Date && report.PurchaseDate.Date <= toDate.Date)
		.Where(report => string.IsNullOrWhiteSpace(operatorSearch)
			|| GetOperator(report).Contains(operatorSearch, StringComparison.OrdinalIgnoreCase)
			|| (report.EmailAddress?.Contains(operatorSearch, StringComparison.OrdinalIgnoreCase) ?? false))
		.OrderByDescending(report => report.PurchaseDate)
		.ToList();

	protected override Task OnInitializedAsync() => LoadReports();

	private async Task LoadReports()
	{
		isLoading = true;
		errorMessage = string.Empty;
		try { reports.Clear(); reports.AddRange(await PurchaseEndpoint.GetPurchaseReport()); }
		catch (Exception ex) { errorMessage = ex.Message; }
		finally { isLoading = false; }
	}

	private static string GetOperator(PurchaseReportModel report)
	{
		var name = $"{report.FirstName} {report.LastName}".Trim();
		return string.IsNullOrWhiteSpace(name) ? report.EmailAddress : name;
	}
}
