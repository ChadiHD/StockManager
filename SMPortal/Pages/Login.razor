@page "/login"
@attribute [AllowAnonymous]
@inject IAuthenticationService AuthService
@inject NavigationManager NavManager

<PageTitle>Sign in | StockManager</PageTitle>

@* Single centred column — the marketing panel that used to sit on the left has been removed. *@
<section class="auth-page auth-page--single">
    <div class="auth-form-panel">
        <EditForm Model="model" OnValidSubmit="ExecuteLogin" class="auth-card">
            <DataAnnotationsValidator />
            <div class="auth-card-heading">
                <span class="eyebrow">Secure access</span>
                <h2>Welcome back</h2>
                <p>Sign in with your StockManager account.</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(authenticationError))
            {
                <div class="alert error" role="alert">
                    <strong>We could not sign you in.</strong>
                    <span>@authenticationError</span>
                </div>
            }

            <div class="field">
                <label for="email">Email address</label>
                <InputText id="email" type="email" autocomplete="username" @bind-Value="model.Email"
                           placeholder="name@company.com" disabled="@isSubmitting" />
                <ValidationMessage For="@(() => model.Email)" />
            </div>
            <div class="field">
                <label for="password">Password</label>
                <div class="password-field">
                    <InputText id="password" type="@(showPassword ? "text" : "password")"
                               autocomplete="current-password" @bind-Value="model.Password"
                               placeholder="Enter your password" disabled="@isSubmitting" />
                    <button type="button" class="password-toggle" @onclick="() => showPassword = !showPassword"
                            disabled="@isSubmitting" aria-pressed="@showPassword"
                            aria-label="@(showPassword ? "Hide password" : "Show password")"
                            title="@(showPassword ? "Hide password" : "Show password")">
                        @if (showPassword)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M9.9 4.24A9.1 9.1 0 0 1 12 4c7 0 10 8 10 8a18 18 0 0 1-2.16 3.19M6.6 6.6A18 18 0 0 0 2 12s3 8 10 8a9.1 9.1 0 0 0 5.4-1.6" />
                                <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" /><path d="M2 2l20 20" />
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M2 12s3-8 10-8 10 8 10 8-3 8-10 8-10-8-10-8z" /><circle cx="12" cy="12" r="3" />
                            </svg>
                        }
                    </button>
                </div>
                <ValidationMessage For="@(() => model.Password)" />
            </div>
            <button type="submit" class="button primary wide" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="spinner small" aria-hidden="true"></span>
                    <span>Signing in...</span>
                }
                else
                {
                    <span>Sign in securely</span>
                }
            </button>
            <p class="auth-help">Accounts are managed by a StockManager administrator.</p>
        </EditForm>
    </div>
</section>

@code {
    private readonly AuthenticationUserModel model = new();
    private string authenticationError = string.Empty;
    private bool isSubmitting;
    private bool showPassword;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private async Task ExecuteLogin()
    {
        authenticationError = string.Empty;
        isSubmitting = true;

        try
        {
            var result = await AuthService.Login(model);
            if (result is null)
            {
                authenticationError = "Check your email and password, then try again.";
                return;
            }

            var destination = !string.IsNullOrWhiteSpace(ReturnUrl) &&
                              Uri.IsWellFormedUriString(ReturnUrl, UriKind.Relative)
                ? ReturnUrl
                : "/";
            NavManager.NavigateTo(destination);
        }
        catch (HttpRequestException)
        {
            authenticationError = "The StockManager service is unavailable. Try again shortly.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
