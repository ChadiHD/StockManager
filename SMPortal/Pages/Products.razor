@page "/products"
@attribute [Authorize(Roles = "Staff")]
@inject IProductEndpoint ProductEndpoint

<PageTitle>Products | StockManager</PageTitle>

<header class="page-header">
	<div>
		<span class="eyebrow">Sales catalogue</span>
		<h1>Products</h1>
		<p>Find product identifiers, prices, tax status, and current stock availability.</p>
	</div>
	<button class="button secondary" @onclick="LoadProducts" disabled="@isLoading">Refresh products</button>
</header>

<section class="panel">
	<div class="toolbar">
		<div class="field search-field">
			<label for="product-search">Search products</label>
			<InputText id="product-search" @bind-Value="searchText" @bind-Value:event="oninput"
					   placeholder="Name, description, or product ID" />
		</div>
		<div class="toolbar-summary" aria-live="polite">
			<strong>@FilteredProducts.Count</strong>
			<span>products shown</span>
		</div>
	</div>

	@if (isLoading)
	{
		<div class="route-state" role="status"><span class="spinner"></span><strong>Loading products</strong></div>
	}
	else if (!string.IsNullOrWhiteSpace(errorMessage))
	{
		<div class="alert error" role="alert"><strong>Products could not be loaded.</strong><span>@errorMessage</span></div>
	}
	else if (FilteredProducts.Count == 0)
	{
		<div class="empty-state"><strong>No products found</strong><span>Try another search or refresh the catalogue.</span></div>
	}
	else
	{
		<div class="table-wrap">
			<table>
				<thead><tr><th>Product</th><th>Identifier</th><th>Retail price</th><th>Tax</th><th>Availability</th></tr></thead>
				<tbody>
					@foreach (var product in FilteredProducts)
					{
						<tr>
							<td data-label="Product">
								<span class="table-primary">@product.ProductName</span>
								<small>@product.Description</small>
							</td>
							<td data-label="Identifier">@product.Id</td>
							<td data-label="Retail price">@product.RetailPrice.ToString("C")</td>
							<td data-label="Tax">@(product.IsTaxable ? "Taxable" : "Not taxable")</td>
							<td data-label="Availability">
								<span class="status-badge @GetStockClass(product.QuantityInStock)">@GetStockLabel(product.QuantityInStock)</span>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
</section>

@code {
	private readonly List<ProductModel> products = new();
	private string searchText = string.Empty;
	private string errorMessage = string.Empty;
	private bool isLoading = true;

	private List<ProductModel> FilteredProducts => products
		.Where(product => string.IsNullOrWhiteSpace(searchText)
			|| product.Id.ToString().Contains(searchText, StringComparison.OrdinalIgnoreCase)
			|| (product.ProductName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
			|| (product.Description?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false))
		.OrderBy(product => product.ProductName)
		.ToList();

	protected override Task OnInitializedAsync() => LoadProducts();

	private async Task LoadProducts()
	{
		isLoading = true;
		errorMessage = string.Empty;
		try
		{
			products.Clear();
			products.AddRange(await ProductEndpoint.GetAll());
		}
		catch (Exception ex)
		{
			errorMessage = ex.Message;
		}
		finally
		{
			isLoading = false;
		}
	}

	private static string GetStockClass(int quantity) => quantity switch { <= 0 => "danger", <= 5 => "warning", _ => "success" };
	private static string GetStockLabel(int quantity) => quantity switch { <= 0 => "Out of stock", <= 5 => $"Low · {quantity}", _ => $"{quantity} in stock" };
}
