@page "/users"
@attribute [Authorize(Roles = "Admin")]
@inject IUserEndpoint UserEndpoint

<PageTitle>Users and roles | StockManager</PageTitle>

<header class="page-header">
	<div><span class="eyebrow">Administration</span><h1>Users &amp; roles</h1><p>Create accounts and control access to StockManager workspaces.</p></div>
	<button class="button secondary" @onclick="LoadData" disabled="@isLoading">Refresh users</button>
</header>

<section class="panel form-panel">
	<div class="panel-heading"><div><span class="eyebrow">New account</span><h2>Create user</h2></div></div>
	@if (!string.IsNullOrWhiteSpace(actionMessage))
	{
		<div class="alert @actionMessageClass" role="status"><span>@actionMessage</span></div>
	}
	<EditForm Model="newUser" OnValidSubmit="CreateUser">
		<DataAnnotationsValidator /><ValidationSummary />
		<div class="form-grid user-form">
			<div class="field"><label for="first-name">First name</label><InputText id="first-name" @bind-Value="newUser.FirstName" /><ValidationMessage For="@(() => newUser.FirstName)" /></div>
			<div class="field"><label for="last-name">Last name</label><InputText id="last-name" @bind-Value="newUser.LastName" /><ValidationMessage For="@(() => newUser.LastName)" /></div>
			<div class="field"><label for="new-email">Email</label><InputText id="new-email" type="email" @bind-Value="newUser.EmailAddress" /><ValidationMessage For="@(() => newUser.EmailAddress)" /></div>
			<div class="field"><label for="new-password">Password</label><InputText id="new-password" type="password" autocomplete="new-password" @bind-Value="newUser.Password" /><ValidationMessage For="@(() => newUser.Password)" /></div>
			<div class="field"><label for="confirm-password">Confirm password</label><InputText id="confirm-password" type="password" autocomplete="new-password" @bind-Value="newUser.ConfirmPassword" /><ValidationMessage For="@(() => newUser.ConfirmPassword)" /></div>
		</div>
		<button class="button primary" type="submit" disabled="@isSaving">@(isSaving ? "Creating..." : "Create user")</button>
	</EditForm>
</section>

<section class="panel">
	<div class="panel-heading"><div><span class="eyebrow">Access control</span><h2>Team accounts</h2></div><span class="muted">@users.Count users</span></div>
	@if (isLoading)
	{
		<div class="route-state" role="status"><span class="spinner"></span><strong>Loading users and roles</strong></div>
	}
	else if (!string.IsNullOrWhiteSpace(loadError))
	{
		<div class="alert error" role="alert"><strong>Users could not be loaded.</strong><span>@loadError</span></div>
	}
	else if (users.Count == 0)
	{
		<div class="empty-state"><strong>No users found</strong><span>Create an account to get started.</span></div>
	}
	else
	{
		<div class="user-grid">
			@foreach (var user in users.OrderBy(user => user.Email))
			{
				<article class="user-card">
					<div class="user-card-heading"><span class="avatar">@GetInitial(user.Email)</span><div><strong>@user.Email</strong><small>@(user.Roles.Count == 0 ? "No roles assigned" : user.RoleList)</small></div></div>
					<div class="role-list" aria-label="Roles for @user.Email">
						@foreach (var role in roles.OrderBy(role => role.Value))
						{
							var assigned = user.Roles.ContainsKey(role.Key) || user.Roles.Values.Contains(role.Value);
							<button type="button" class="role-toggle @(assigned ? "assigned" : null)" aria-pressed="@assigned" disabled="@IsBusy(user, role.Value)" @onclick="() => ToggleRole(user, role.Value, assigned)">
								<span class="role-check" aria-hidden="true">@(assigned ? "✓" : "+")</span>@role.Value
							</button>
						}
					</div>
				</article>
			}
		</div>
	}
</section>

@code {
	private readonly List<UserModel> users = new();
	private readonly Dictionary<string, string> roles = new();
	private CreateUserModel newUser = new();
	private string loadError = string.Empty;
	private string actionMessage = string.Empty;
	private string actionMessageClass = "success";
	private string busyRole = string.Empty;
	private bool isLoading = true;
	private bool isSaving;

	protected override Task OnInitializedAsync() => LoadData();

	private async Task LoadData()
	{
		isLoading = true;
		loadError = string.Empty;
		try
		{
			var userRequest = UserEndpoint.GetAll();
			var roleRequest = UserEndpoint.GetAllRoles();
			await Task.WhenAll(userRequest, roleRequest);
			users.Clear(); users.AddRange(await userRequest);
			roles.Clear(); foreach (var role in await roleRequest) roles[role.Key] = role.Value;
		}
		catch (Exception ex) { loadError = ex.Message; }
		finally { isLoading = false; }
	}

	private async Task CreateUser()
	{
		isSaving = true;
		actionMessage = string.Empty;
		try
		{
			await UserEndpoint.CreateUser(newUser);
			newUser = new();
			actionMessageClass = "success";
			actionMessage = "The user account was created.";
			await LoadData();
		}
		catch (Exception ex) { actionMessageClass = "error"; actionMessage = $"The account could not be created. {ex.Message}"; }
		finally { isSaving = false; }
	}

	private async Task ToggleRole(UserModel user, string roleName, bool assigned)
	{
		busyRole = $"{user.EffectiveUserId}:{roleName}";
		actionMessage = string.Empty;
		try
		{
			if (assigned) await UserEndpoint.RemoveUserFromRole(user.EffectiveUserId, roleName);
			else await UserEndpoint.AddUserToRole(user.EffectiveUserId, roleName);
			actionMessageClass = "success";
			actionMessage = $"{roleName} access was {(assigned ? "removed from" : "added to")} {user.Email}.";
			await LoadData();
		}
		catch (Exception ex) { actionMessageClass = "error"; actionMessage = $"The role could not be updated. {ex.Message}"; }
		finally { busyRole = string.Empty; }
	}

	private bool IsBusy(UserModel user, string roleName) => busyRole == $"{user.EffectiveUserId}:{roleName}";
	private static string GetInitial(string? email) => string.IsNullOrWhiteSpace(email) ? "U" : email[..1].ToUpperInvariant();
}
