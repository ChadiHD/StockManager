<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows7.0</TargetFramework>
		<UseWPF>true</UseWPF>
	</PropertyGroup>
	<ItemGroup>
	  <PackageReference Include="AutoMapper" Version="16.2.0" />
	  <PackageReference Include="Caliburn.Micro" Version="5.0.258" />
	  <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
	  <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\SMDesktopUI.Library\SMDesktopUI.Library.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <None Update="appsettings.Development.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="appsettings.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="appsettings.Production.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>
</Project>