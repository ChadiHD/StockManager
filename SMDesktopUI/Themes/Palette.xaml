<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Navy950">#0B172A</Color>
    <Color x:Key="Navy900">#10233F</Color>
    <Color x:Key="Slate700">#334155</Color>
    <Color x:Key="Slate500">#64748B</Color>
    <Color x:Key="Slate300">#CBD5E1</Color>
    <Color x:Key="Slate200">#E2E8F0</Color>
    <Color x:Key="Slate100">#F1F5F9</Color>
    <Color x:Key="Slate50">#F8FAFC</Color>
    <Color x:Key="Teal600">#0D9488</Color>
    <Color x:Key="Teal500">#14B8A6</Color>
    <Color x:Key="Green600">#15803D</Color>
    <Color x:Key="Amber600">#D97706</Color>
    <Color x:Key="Red600">#DC2626</Color>

    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource Navy900}"/>
    <SolidColorBrush x:Key="NavyDarkBrush" Color="{StaticResource Navy950}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Slate700}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource Slate500}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Slate300}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="White"/>
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource Slate50}"/>
    <SolidColorBrush x:Key="TealBrush" Color="{StaticResource Teal600}"/>
    <SolidColorBrush x:Key="TealHoverBrush" Color="{StaticResource Teal500}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Green600}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Amber600}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Red600}"/>
</ResourceDictionary>
