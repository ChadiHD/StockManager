<UserControl x:Class="SMDesktopUI.Views.UserDisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1100">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="User administration" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Review operators and manage role assignments."
                       Style="{StaticResource CaptionText}" Margin="0,4,0,20"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" MinWidth="320"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.4*" MinWidth="420"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Operators" Style="{StaticResource SectionTitle}" Margin="18"/>
                    <ListBox x:Name="Users" Grid.Row="1" BorderThickness="0"
                             SelectedItem="{Binding SelectedUser}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Email}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding RoleList}" Style="{StaticResource CaptionText}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Role access" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="SelectedUserName" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource TealBrush}" Margin="0,8,0,4"/>
                        <TextBlock Text="Select an operator to review or change their permissions."
                                   Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,24,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="_Available role" FontWeight="SemiBold"/>
                            <ComboBox x:Name="AvailableRoles" Margin="0,7,12,0"
                                      SelectedItem="{Binding SelectedAvailableRole}"/>
                        </StackPanel>
                        <Button x:Name="AddSelectedRole" Grid.Column="1" Content="_Assign role"
                                VerticalAlignment="Bottom"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Assigned roles" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <ListBox x:Name="UserRoles" Grid.Row="1"
                                 SelectedItem="{Binding SelectedUserRole}"/>
                        <Button x:Name="RemoveSelectedRole" Grid.Row="2" Content="_Remove selected role"
                                Style="{StaticResource DangerButton}" HorizontalAlignment="Right"
                                Margin="0,14,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
