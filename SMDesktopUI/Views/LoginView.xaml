<UserControl x:Class="SMDesktopUI.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="650" d:DesignWidth="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.05*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource NavyBrush}" Padding="56">
            <StackPanel VerticalAlignment="Center" MaxWidth="440">
                <Border Width="58" Height="58" CornerRadius="10" Background="{StaticResource TealBrush}"
                        HorizontalAlignment="Left">
                    <TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="32"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Operations, without friction." Foreground="White" FontSize="34"
                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,28,0,12"/>
                <TextBlock Text="Secure access to sales, inventory checkout, label printing, and user administration."
                           Foreground="#CBD5E1" FontSize="16" LineHeight="25" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="56,40">
            <Border Style="{StaticResource Card}" MaxWidth="430" VerticalAlignment="Center"
                    HorizontalAlignment="Stretch" Padding="32">
                <StackPanel>
                    <TextBlock Text="Welcome back" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Sign in with your StockManager account."
                               Style="{StaticResource CaptionText}" Margin="0,6,0,26"/>
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                            CornerRadius="5" Padding="12" Margin="0,0,0,18"
                            Visibility="{Binding IsErrorVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock x:Name="ErrorMessage" Foreground="{StaticResource ErrorBrush}"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                    </Border>
                    <TextBlock Text="_Email address" FontWeight="SemiBold"/>
                    <TextBox x:Name="UserName" Margin="0,7,0,18" TabIndex="0"
                             AutomationProperties.Name="Email address"
                             InputScope="EmailSmtpAddress"/>
                    <TextBlock Text="_Password" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="Password" Margin="0,7,0,24" TabIndex="1"
                                 AutomationProperties.Name="Password"/>
                    <Button x:Name="LogIn" Content="_Sign in" IsDefault="True" TabIndex="2"
                            MinHeight="46" FontWeight="SemiBold"/>
                    <TextBlock Text="Credentials are sent only to the configured StockManager API."
                               Style="{StaticResource CaptionText}" TextAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
