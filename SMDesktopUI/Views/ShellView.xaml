<Window x:Class="SMDesktopUI.Views.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="StockManager Operations" Height="780" Width="1280"
        MinHeight="640" MinWidth="980" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource NavyDarkBrush}">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="5" Background="{StaticResource TealBrush}">
                        <TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="STOCKMANAGER" Foreground="White" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,18,0"/>
                </StackPanel>
                <Menu Grid.Column="1">
                    <MenuItem Header="_Operations">
                        <MenuItem x:Name="UserManagement" Header="_User administration"
                                  Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </MenuItem>
                    <MenuItem Header="_File">
                        <MenuItem x:Name="ExitApplication" Header="E_xit"/>
                    </MenuItem>
                </Menu>
                <Button x:Name="LogOut" Grid.Column="2" Content="_Sign out"
                        Style="{StaticResource SecondaryButton}" Margin="12,8,0,8" MinHeight="32"
                        Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,7">
            <TextBlock Text="StockManager desktop operations  •  Secure API session"
                       Style="{StaticResource CaptionText}"/>
        </Border>
        <ContentControl x:Name="ActiveItem"/>
    </DockPanel>
</Window>
