<!-- SDK-style SQL project, so `dotnet build` produces the DACPAC and CI needs no Visual Studio.

     This was attempted once before on Microsoft.Build.Sql 1.x and reverted: VS 18 ships SSDT
     targets that pass SqlBuildTask parameters (AutomaticIndexCompaction,
     AcceleratedDatabaseRecovery) which the 1.x task did not declare, so the build failed with
     MSB4064 / MSB4063 depending on which task assembly won. The 2.x SDK declares them, which is
     what makes the conversion viable now — if a build in Visual Studio ever reports MSB4064 on a
     property name again, that is this same collision and the SDK version is the thing to look
     at, not the project layout. -->
<Project Sdk="Microsoft.Build.Sql/2.2.0">
  <PropertyGroup>
    <Name>SMDatabase</Name>
    <ProjectGuid>{d1a3d78b-7c53-46d6-9079-20ff94a9b15d}</ProjectGuid>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <TargetDatabaseSet>True</TargetDatabaseSet>
    <DeployToDatabase>True</DeployToDatabase>

    <!-- Full-framework Visual Studio MSBuild preloads its installed SQL task assembly. Use the
         matching SSDT targets so task parameters and the loaded assembly stay compatible. -->
    <BuildFromSSDT>true</BuildFromSSDT>

    <!-- Pinned explicitly. Left unset, `dotnet build` restores netstandard2.0 while a build
         through Visual Studio's MSBuild evaluates net472 (VS still supplies the legacy SSDT
         TargetFrameworkVersion of v4.7.2), and the two disagree:
         "error NETSDK1005: Assets file ... doesn't have a target for 'net472'". -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- The Aspire app host reads SMDatabase/bin/Debug/SMDatabase.dacpac and fails fast when it
         is missing. Without this the SDK would nest the output under a target-framework folder
         and the app host would refuse to start. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- The SDK globs **/*.sql as Build items, which is why individual tables and procedures no
         longer need listing. Deployment scripts are not schema, so they are removed from that
         glob and declared for their phase instead. -->
    <Build Remove="Scripts\**\*.sql" />
    <PostDeploy Include="Scripts\PostDeployment\Seed.sql" />
    <RefactorLog Include="SMDatabase.refactorlog" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Scripts\" />
    <Folder Include="Scripts\PostDeployment\" />
  </ItemGroup>
</Project>