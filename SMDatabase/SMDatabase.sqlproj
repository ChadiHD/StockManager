    <Build Include="dbo\Store Procedures\spInventory_GetAll.sql" />
    <Build Include="dbo\Store Procedures\spInventory_Insert.sql" />
    <Build Include="dbo\Store Procedures\spOrder_ConvertFromQuote.sql" />
    <Build Include="dbo\Store Procedures\spOrder_GetAll.sql" />
    <Build Include="dbo\Store Procedures\spOrder_GetByReference.sql" />
    <Build Include="dbo\Store Procedures\spOrder_Insert.sql" />
    <Build Include="dbo\Store Procedures\spOrder_UpdateStatus.sql" />
    <Build Include="dbo\Store Procedures\spOrderLine_GetByOrder.sql" />
    <Build Include="dbo\Store Procedures\spProduct_BulkUpsertFromFeed.sql" />
    <Build Include="dbo\Store Procedures\spProduct_GetAll.sql" />
    <Build Include="dbo\Store Procedures\spProduct_GetById.sql" />
    <Build Include="dbo\Store Procedures\spProduct_GetBySku.sql" />
    <Build Include="dbo\Store Procedures\spProduct_Insert.sql" />
    <Build Include="dbo\Store Procedures\spProduct_SyncFeeds.sql" />
    <Build Include="dbo\Store Procedures\spProduct_Update.sql" />
    <Build Include="dbo\Store Procedures\spPurchase_Insert.sql" />
    <Build Include="dbo\Store Procedures\spPurchase_LookUp.sql" />
    <Build Include="dbo\Store Procedures\spPurchase_PurchaseReport.sql" />
    <Build Include="dbo\Store Procedures\spPurchaseDetails_Insert.sql" />
    <Build Include="dbo\Store Procedures\spQuote_GetAll.sql" />
    <Build Include="dbo\Store Procedures\spQuote_GetByReference.sql" />
    <Build Include="dbo\Store Procedures\spQuote_Insert.sql" />
    <Build Include="dbo\Store Procedures\spQuote_UpdateStatus.sql" />
    <Build Include="dbo\Store Procedures\spQuoteLine_GetByQuote.sql" />
    <Build Include="dbo\Store Procedures\spQuoteLine_Insert.sql" />
    <Build Include="dbo\Store Procedures\spReport_GetSales.sql" />
    <Build Include="dbo\Store Procedures\spUser_GetAll.sql" />
    <Build Include="dbo\Store Procedures\spUser_Insert.sql" />
    <Build Include="dbo\Store Procedures\spUserLookup.sql" />
    <Build Include="dbo\Tables\Account.sql" />
    <Build Include="dbo\Tables\CustomerGroup.sql" />
    <Build Include="dbo\Tables\DistributorFeed.sql" />
    <Build Include="dbo\Tables\Inventory.sql" />
    <Build Include="dbo\Tables\Product.sql" />
    <Build Include="dbo\Tables\Purchase.sql" />
    <Build Include="dbo\Tables\PurchaseDetail.sql" />
    <Build Include="dbo\Tables\Quote.sql" />
    <Build Include="dbo\Tables\QuoteLine.sql" />
    <Build Include="dbo\Tables\User.sql" />
    <Build Include="dbo\User Defined Types\DistributorFeedItem.sql" />
  </ItemGroup>
  <ItemGroup>
    <RefactorLog Include="SMDatabase.refactorlog" />
  </ItemGroup>
</Project>
