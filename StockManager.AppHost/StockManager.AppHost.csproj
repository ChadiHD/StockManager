<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>f2718572-14eb-4c66-b29b-7d3a59611451</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="13.4.6" />
    <PackageReference Include="Aspire.Hosting.Azure.Sql" Version="13.4.6" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.4.6" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.SqlDatabaseProjects" Version="13.4.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Update="Microsoft.NET.StringTools" Version="18.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SMDatabase\SMDatabase.sqlproj"
                      ReferenceOutputAssembly="false"
                      IsAspireProjectResource="false" />
    <ProjectReference Include="..\StockApi\StockApi.csproj" />
    <ProjectReference Include="..\SMPortal\SMPortal.csproj" />
    <ProjectReference Include="..\SMStore\SMStore.csproj" />
  </ItemGroup>

  <!-- AppHost.cs needs the DACPAC's location, and it cannot be assumed: the path moves with
       $(Configuration) and again with $(BaseOutputPath), which CLAUDE.md tells people to
       redirect when a running app host locks the bin directories. Guessing "bin\Debug" left the
       guard reading a file that build had never written. Ask the SQL project where its output
       actually went and bake that answer in, so the two can never disagree. -->
  <Target Name="ResolveSMDatabaseDacpacPath" BeforeTargets="GetAssemblyAttributes">
    <MSBuild Projects="@(ProjectReference->WithMetadataValue('Extension', '.sqlproj'))"
             Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="_SMDatabaseDacpac" />
    </MSBuild>

    <ItemGroup>
      <AssemblyMetadata Include="SMDatabaseDacpacPath" Value="%(_SMDatabaseDacpac.FullPath)" />
    </ItemGroup>
  </Target>

</Project>
