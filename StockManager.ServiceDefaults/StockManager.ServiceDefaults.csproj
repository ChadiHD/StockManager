<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireSharedProject>true</IsAspireSharedProject>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

    <!-- The Data Protection key ring is shared by StockApi and SMStore, so its storage lives
         here rather than in either app. Both projects are ASP.NET Core apps; nothing else
         references this project, so the EF dependency does not reach the WPF client. -->
    <PackageReference Include="Aspire.Azure.Storage.Blobs" Version="13.5.3" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.4" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <!-- 7.x, as StockApi: EF brings 6.1.1, which brings Azure.Identity, and Azure.Core 1.55+ now
         defines DefaultAzureCredential itself, so the two together make it ambiguous (CS0433). -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <!-- 7.x moved Entra sign-in out of the core package. Aspire's Azure SQL connection strings say
         Authentication=Active Directory Default, and SqlClient looks for this assembly by name to
         serve it; without it both apps crash at startup on Azure with "Cannot find an
         authentication provider for 'ActiveDirectoryDefault'". Local SQL Server never asks for
         Entra sign-in, so nothing here notices it missing. Keep it on SqlClient's version. -->
    <PackageReference Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.0.2" />
    <!-- That package brings Azure.Identity 1.18, which defines DefaultAzureCredential beside
         Azure.Core's own (CS0433, as above). 1.21 is the first that forwards it to Azure.Core. -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.6.0" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.6.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
  </ItemGroup>

</Project>
