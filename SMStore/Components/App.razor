@inject ISiteContext SiteContext
@inject SiteThemeResolver Themes

<!DOCTYPE html>
<html lang="@SiteContext.Site.Locale">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    @* app.css is structure only and carries no colour of its own; the site theme supplies the
       custom properties it reads, so it must load second. *@
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@_theme.StylesheetPath" />
    <link rel="stylesheet" href="@Assets["SMStore.styles.css"]" />
    <link rel="icon" href="@_theme.FaviconPath" />
    @* No <ImportMap />: nothing here imports a JavaScript module, and it renders an inline
       script the Content-Security-Policy would refuse. *@
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["print.js"]"></script>
</body>

</html>

@code {
    private SiteTheme _theme = default!;

    protected override void OnInitialized() => _theme = Themes.Resolve(SiteContext.Site.SiteKey);
}
