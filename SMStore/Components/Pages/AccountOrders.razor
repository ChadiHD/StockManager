@page "/account/orders"

@using SMStore.Accounts
@using SMStore.Ordering
@inject ISiteContext SiteContext
@inject ICustomerContext Customer
@inject CustomerOrderPresenter Documents
@inject NavigationManager Navigation

<PageTitle>@L["Your orders"] · @SiteContext.Site.Name</PageTitle>

<Breadcrumb Items="_crumbs" />

<div class="page-header">
    <div>
        <h1>@L["Your orders"]</h1>
        <p class="page-lede">@L["Confirmed orders, their status and their paperwork."]</p>
    </div>
</div>

<DocumentList Items="_orders" Href="@(reference => $"/account/orders/{reference}")"
              EmptyMessage="@(L["You have no orders yet."])"
              EmptyActionHref="@QuoteDecisionEndpoints.QuotesPath"
              EmptyActionLabel="@(L["See your quotes"])" />

@code {
    private readonly NavItem[] _crumbs =
    [
        new(L["Home"], "/"),
        new(L["Your account"], "/account"),
        new(L["Orders"], "/account/orders"),
    ];

    private IReadOnlyList<DocumentSummary> _orders = [];

    protected override void OnInitialized()
    {
        if (!Customer.IsSignedIn)
        {
            Navigation.NavigateTo(
                $"{CustomerAuthentication.LoginPath}?returnUrl={Uri.EscapeDataString("/account/orders")}");

            return;
        }

        _orders = Documents.Orders();
    }
}
