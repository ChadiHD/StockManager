@page "/account/orders/{Reference}"

@using SMStore.Accounts
@using SMStore.Ordering
@inject ISiteContext SiteContext
@inject ICustomerContext Customer
@inject CustomerOrderPresenter Documents
@inject NavigationManager Navigation

<PageTitle>@Reference · @SiteContext.Site.Name</PageTitle>

<Breadcrumb Items="Crumbs" />

@if (_order is null)
{
    @* Same answer for "not yours" as for "not here"; see AccountQuoteDetail. *@
    <div class="page-header">
        <div>
            <h1>@L["Not found"]</h1>
            <p class="page-lede">@L["We have no order with that reference on your account."]</p>
        </div>
    </div>

    <a href="@QuoteDecisionEndpoints.OrdersPath" class="btn btn-secondary">@L["Back to your orders"]</a>
}
else
{
    <div class="page-header">
        <div>
            <h1 class="mono">@_order.Reference</h1>
            <p class="page-lede">
                @L["Placed {0}", _order.Placed.ToString("d MMM yyyy")]
                @if (_order.FromQuoteReference is not null)
                {
                    <text> · @L["from"] </text>
                    <a href="@($"{QuoteDecisionEndpoints.QuotesPath}/{_order.FromQuoteReference}")"
                       class="mono">@_order.FromQuoteReference</a>
                }
            </p>
        </div>
        <span class="tag tag-neutral">@_order.Status</span>
    </div>

    @if (Placed)
    {
        <p class="document__notice" role="status">@L["Thank you. We have your order, and we have emailed you a copy."]</p>
    }

    <PaymentNotice Order="_order" Paid="@PaidFlag" Payment="@PaymentFlag" />

    <OrderDocument Order="_order" PrintHref="@($"{QuoteDecisionEndpoints.OrdersPath}/{Reference}/print")" />
}

@code {
    [Parameter] public string Reference { get; set; } = string.Empty;

    /// <summary>Set by the checkout's redirect (T12). Only ever compared, never rendered.</summary>
    [SupplyParameterFromQuery(Name = "placed")]
    public string? PlacedFlag { get; set; }

    private bool Placed => PlacedFlag == "1";

    /// <summary>Set by the provider's return and by a failed "Pay now" (T13). Compared, never rendered.</summary>
    [SupplyParameterFromQuery(Name = "paid")]
    public string? PaidFlag { get; set; }

    [SupplyParameterFromQuery(Name = "payment")]
    public string? PaymentFlag { get; set; }

    private OrderView? _order;

    private NavItem[] Crumbs =>
    [
        new(L["Home"], "/"),
        new(L["Your account"], "/account"),
        new(L["Orders"], QuoteDecisionEndpoints.OrdersPath),
        new(Reference, $"{QuoteDecisionEndpoints.OrdersPath}/{Reference}"),
    ];

    protected override void OnParametersSet()
    {
        if (!Customer.IsSignedIn)
        {
            var target = $"{QuoteDecisionEndpoints.OrdersPath}/{Uri.EscapeDataString(Reference)}";

            Navigation.NavigateTo(
                $"{CustomerAuthentication.LoginPath}?returnUrl={Uri.EscapeDataString(target)}");

            return;
        }

        _order = Documents.Order(Reference);
    }
}
