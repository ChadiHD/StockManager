@page "/account/quotes/{Reference}/print"

@using SMStore.Accounts
@using SMStore.Ordering
@inject ISiteContext SiteContext
@inject ICustomerContext Customer
@inject CustomerOrderPresenter Documents
@inject NavigationManager Navigation

<PageTitle>@Reference · @SiteContext.Site.Name</PageTitle>

@if (_quote is null || _party is null)
{
    @* Same answer for "not yours" and "not here" as the detail page gives, and for the same
       reason: references come from a sequence, so a distinguishable refusal would confirm
       which ones exist. *@
    <div class="page-header">
        <div>
            <h1>@L["Not found"]</h1>
            <p class="page-lede">@L["We have no quote with that reference on your account."]</p>
        </div>
    </div>

    <a href="@QuoteDecisionEndpoints.QuotesPath" class="btn btn-secondary">@L["Back to your quotes"]</a>
}
else
{
    <div class="sheet__actions">
        <a href="@($"{QuoteDecisionEndpoints.QuotesPath}/{Reference}")" class="btn btn-secondary">
            @L["Back to the quote"]
        </a>
        @* data-print, handled by wwwroot/print.js, and not an inline onclick: the storefront's
           Content-Security-Policy allows no inline script. It needs no circuit and no render
           round trip, and without JavaScript the browser's own print command does the same. *@
        <button type="button" class="btn btn-primary" data-print>@L["Print or save as PDF"]</button>
    </div>

    <DocumentSheet Kind="@Label"
                   Reference="@_quote.Reference"
                   Party="_party"
                   Meta="Meta"
                   Lines="_quote.Lines"
                   Totals="Totals"
                   Note="@_quote.CustomerNote"
                   NoteHeading="@(L["What you told us"])"
                   FooterNote="@FooterNote" />
}

@code {
    [Parameter] public string Reference { get; set; } = string.Empty;

    private QuoteView? _quote;
    private DocumentParty? _party;

    private IOrderingMode Mode => Documents.Mode;

    private string Label => Mode.BasketLabel;

    private IReadOnlyList<(string, string)> Meta =>
    [
        (L["Status"], _quote!.Status),
        (L["Raised"], _quote.Raised.ToString("d MMM yyyy")),
        (L["Valid until"], _quote.Expires?.ToString("d MMM yyyy") ?? L["No expiry set"]),
    ];

    private IReadOnlyList<(string, string)> Totals =>
    [
        (L["Lines"], _quote!.Lines.Count.ToString()),
        (Mode.ShowsPayableTotal ? L["Total"] : L["Quoted value"], _quote.Value),
    ];

    private string FooterNote => (Mode.ShowsPayableTotal, SiteContext.Site.PricesIncludeTax) switch
    {
        (true, true) => L["Including tax. Freight is calculated at checkout."],
        (true, false) => L["Excluding tax and freight, which are calculated at checkout."],
        (false, true) => L["Including tax. Freight is calculated on the order."],
        (false, false) => L["Excluding tax and freight, which are calculated on the order."]
    };

    protected override void OnParametersSet()
    {
        if (!Customer.IsSignedIn)
        {
            var target = $"{QuoteDecisionEndpoints.QuotesPath}/{Uri.EscapeDataString(Reference)}/print";

            Navigation.NavigateTo(
                $"{CustomerAuthentication.LoginPath}?returnUrl={Uri.EscapeDataString(target)}");

            return;
        }

        _quote = Documents.Quote(Reference);
        _party = Documents.Party();
    }
}
