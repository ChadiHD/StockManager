@* The path is repeated from CustomerAuthentication.ResetPasswordPath because @page cannot
   read a constant, and the rate limiter has to recognise the posted path before routing has
   picked an endpoint. If one moves, the other has to. *@
@page "/reset-password"
@using SMStore.Accounts
@inject ISiteContext SiteContext
@inject PasswordResetService Resets

<PageTitle>Choose a new password · @SiteContext.Site.Name</PageTitle>

<div class="signin">
    <div class="signin__panel card blueprint">
        <i class="corner tl"></i><i class="corner tr"></i>
        <i class="corner bl"></i><i class="corner br"></i>

        @if (_outcome?.Succeeded == true)
        {
            <h1 class="signin__title">Password changed</h1>
            <p class="text-muted signin__lede">
                You can sign in with the new password now. Anywhere that was already signed in
                as you has been signed out.
            </p>

            <a href="@CustomerAuthentication.LoginPath" class="btn btn-primary btn-block">
                Go to sign in
            </a>
        }
        else if (_outcome?.Result == PasswordResetResult.LinkNotUsable || !HasLink)
        {
            @* One message for a link that failed and for arriving with none: an expired token,
               one already spent, a mangled one, a user id that names nobody, and a login
               belonging to another store all land here. Distinguishing them would tell an
               unauthenticated caller which ids exist and which store they belong to, and the
               next step is the same in every case. *@
            <h1 class="signin__title">That link did not work</h1>
            <p class="text-muted signin__lede">
                Reset links expire, and each one only works once. Ask for a fresh one and we
                will email it to the address on the account.
            </p>

            <a href="@CustomerAuthentication.ForgotPasswordPath" class="btn btn-primary btn-block">
                Email me a new link
            </a>
        }
        else
        {
            <h1 class="signin__title">Choose a new password</h1>
            <p class="text-muted signin__lede">
                This link works once. Pick something you have not used here before.
            </p>

            @if (_errors.Count > 0)
            {
                <div class="alert error" role="alert">
                    <strong>We could not set that password.</strong>
                    <ul>
                        @foreach (var error in _errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }

            @* Posts back to this page rather than to an endpoint, because unlike the request
               half this one has something to say: a password the store's rules refuse needs
               the rules quoted and the form kept, and a redirect would have to carry the
               token through a Location header to do it. *@
            <form method="post" class="signin__form" @formname="reset-password"
                  @onsubmit="SubmitAsync">
                <AntiforgeryToken />

                @* The link's two halves travel in the body on the way back, so the form does
                   not depend on the query string surviving the post. Both are re-read from
                   what was posted and validated again by PasswordResetService — neither is
                   trusted for having been here a moment ago. *@
                <input type="hidden" name="@MailedTokenLink.UserIdParameter" value="@LinkUserId" />
                <input type="hidden" name="@MailedTokenLink.TokenParameter" value="@LinkToken" />

                <div class="field">
                    <label for="reset-password-new">New password</label>
                    @* Never given a value attribute, on this render or any other. A rejected
                       password echoed back into the HTML is a password in the page, in the
                       browser's cache and in any proxy log that keeps bodies. *@
                    <input class="input" type="password" id="reset-password-new" name="password"
                           autocomplete="new-password" required />
                </div>

                <div class="field">
                    <label for="reset-password-confirm">Confirm new password</label>
                    <input class="input" type="password" id="reset-password-confirm"
                           name="confirm" autocomplete="new-password" required />
                </div>

                <button type="submit" class="btn btn-primary btn-block">Set new password</button>
            </form>
        }
    </div>
</div>

@code {
    [CascadingParameter] public HttpContext? Http { get; set; }

    /*
    Both bound as text, never as a typed parameter.

    Blazor converts a query-string value during binding and throws on anything it cannot
    convert, before any validation here runs — which is how ?page=abc became an
    unauthenticated 500 on the catalog. These two arrive from a link in an email and are
    attacker-supplied in full.
    */
    [SupplyParameterFromQuery(Name = MailedTokenLink.UserIdParameter)]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = MailedTokenLink.TokenParameter)]
    public string? Token { get; set; }

    private IFormCollection? _posted;
    private PasswordResetOutcome? _outcome;
    private List<string> _errors = [];

    /// <summary>
    /// The user id this render is working with: what was posted once there is a post, and the
    /// query string's until then.
    /// </summary>
    private string? LinkUserId =>
        _posted is null ? UserId : _posted[MailedTokenLink.UserIdParameter].ToString();

    private string? LinkToken =>
        _posted is null ? Token : _posted[MailedTokenLink.TokenParameter].ToString();

    /// <summary>
    /// Whether this is somebody following a link at all, rather than someone who typed the
    /// address in. With no link there is nothing to offer but a fresh one.
    /// </summary>
    private bool HasLink =>
        !string.IsNullOrWhiteSpace(LinkUserId) && !string.IsNullOrWhiteSpace(LinkToken);

    private async Task SubmitAsync()
    {
        _posted = Http?.Request.Form;
        _errors = [];

        if (_posted is null)
        {
            _errors = ["That form did not arrive intact. Please try again."];
            return;
        }

        var password = _posted["password"].ToString();
        var confirm = _posted["confirm"].ToString();

        // Checked here rather than by the service: a mismatch is a typing mistake about this
        // form, not a judgement about the password or the link, and answering it without
        // spending the token means the customer still has a working link to try again with.
        if (!string.Equals(password, confirm, StringComparison.Ordinal))
        {
            _errors = ["Those two passwords are not the same."];
            return;
        }

        _outcome = await Resets.ResetAsync(LinkUserId, LinkToken, password);

        if (_outcome.Result == PasswordResetResult.PasswordRejected)
        {
            _errors = [.. _outcome.Messages];
        }
    }
}
