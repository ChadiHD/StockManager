@* The path is repeated from CustomerAuthentication.ForgotPasswordPath because @page cannot
   read a constant, and the rate limiter has to recognise the posted path before routing has
   picked an endpoint. If one moves, the other has to. *@
@page "/forgot-password"
@using SMStore.Accounts
@inject ISiteContext SiteContext

<PageTitle>Forgotten password · @SiteContext.Site.Name</PageTitle>

<div class="signin">
    <div class="signin__panel card blueprint">
        <i class="corner tl"></i><i class="corner tr"></i>
        <i class="corner bl"></i><i class="corner br"></i>

        @if (Sent)
        {
            @* Where the request endpoint lands, and it says this whether or not any mail was
               sent. An address that has no account here, an address at another of the stores
               run from here, and one whose owner never confirmed it all arrive on this exact
               page — see PasswordResetService.RequestAsync. *@
            <h1 class="signin__title">Check your email</h1>
            <p class="text-muted signin__lede">
                If that address can sign in here, a link to choose a new password is on its
                way. Links expire, so use it soon.
            </p>

            <a href="@CustomerAuthentication.LoginPath" class="btn btn-primary btn-block">
                Back to sign in
            </a>
        }
        else
        {
            <h1 class="signin__title">Forgotten your password?</h1>
            <p class="text-muted signin__lede">
                Give us the address you sign in with and we will email you a link to set a new
                password.
            </p>

            @* Posts to the endpoint rather than back to this page: the answer does not depend
               on the address, so there is nothing to re-render. *@
            <form method="post" action="@CustomerAuthentication.RequestPasswordResetPath"
                  class="signin__form">
                <AntiforgeryToken />

                <div class="field">
                    <label for="forgot-email">Email address</label>
                    <input class="input" type="email" id="forgot-email" name="email"
                           autocomplete="username" required />
                </div>

                <button type="submit" class="btn btn-primary btn-block">Email me a link</button>
            </form>
        }

        @* Shown to everybody, on both branches, because an unconfirmed address gets no reset
           mail and has to be sent somewhere. Showing this only to the people it applies to
           would tell them their address is known here and unconfirmed, which is the
           disclosure the neutral answer above exists to prevent. *@
        <p class="signin__alt">
            Never confirmed your address?
            <a href="@CustomerAuthentication.ConfirmEmailPath">Get a confirmation link</a>.
        </p>

        <p class="signin__alt">
            <a href="@CustomerAuthentication.LoginPath">Back to sign in</a>
        </p>
    </div>
</div>

@code {
    // Bound as text, not bool: Blazor converts a query value during binding and throws on
    // anything it cannot convert, so "?sent=yes" from a hand-edited URL would be a 500.
    [SupplyParameterFromQuery(Name = "sent")] public string? Sent_ { get; set; }

    private bool Sent => Sent_ == "1";
}
