@page "/confirm-email"
@using Microsoft.AspNetCore.Identity
@using SMStore.Accounts
@using StockManager.Identity
@inject ISiteContext SiteContext
@inject UserManager<IdentityUser> Users
@inject ILogger<ConfirmEmail> Logger

<PageTitle>@L["Confirm your email"] · @SiteContext.Site.Name</PageTitle>

<div class="signin">
    <div class="signin__panel card blueprint">
        <i class="corner tl"></i><i class="corner tr"></i>
        <i class="corner bl"></i><i class="corner br"></i>

        @if (_confirmed)
        {
            <h1 class="signin__title">@L["Address confirmed"]</h1>
            <p class="text-muted signin__lede">
                @L["Thank you. We will email you again once your application has been reviewed, and you will be able to sign in then."]
            </p>
            <a href="@CustomerAuthentication.LoginPath" class="btn btn-primary btn-block">@L["Go to sign in"]</a>
        }
        else if (HasLink && !_refused)
        {
            <h1 class="signin__title">@L["Confirm your email address"]</h1>
            <p class="text-muted signin__lede">
                @L["Press the button to confirm this is the address you applied with."]
            </p>

            @* Confirmed on the post, never on arrival. Mail gateways open the links in a
               message to scan them — Safe Links, Mimecast, Proofpoint — and confirming on the
               GET let a scanner at somebody else's company confirm an address an applicant had
               typed in for them, which is the one thing this gate exists to stop. A scanner
               follows links; it does not press buttons. *@
            <form method="post" class="signin__form" @formname="confirm-email" @onsubmit="ConfirmAsync">
                <AntiforgeryToken />
                <input type="hidden" name="@MailedTokenLink.UserIdParameter" value="@UserId" />
                <input type="hidden" name="@MailedTokenLink.TokenParameter" value="@Token" />

                <button type="submit" class="btn btn-primary btn-block">@L["Confirm my address"]</button>
            </form>
        }
        else
        {
            @* One message for every failure: a bad token, an expired one, a link already used,
               and a user id that names nobody. Distinguishing them would tell an unauthenticated
               caller which ids exist and whether a given address has already confirmed — and
               the applicant's next step is the same in every case.

               Arriving with no token at all is a different thing: that is someone who came from
               the sign-in page wanting a new link, not someone whose link failed. Telling them
               their link did not work would be nonsense. *@
            @if (_refused)
            {
                <h1 class="signin__title">@L["That link did not work"]</h1>
                <p class="text-muted signin__lede">
                    @L["It may have expired, or already been used. Ask for a fresh one and we will send it to the address on the application."]
                </p>
            }
            else
            {
                <h1 class="signin__title">@L["Confirm your email address"]</h1>
                <p class="text-muted signin__lede">
                    @L["Tell us the address you applied with and we will send you a fresh confirmation link."]
                </p>
            }

            <form method="post" action="@CustomerAuthentication.ResendConfirmationPath"
                  class="signin__form">
                <AntiforgeryToken />

                <div class="field">
                    <label for="confirm-email-address">@L["Email address"]</label>
                    <input class="input" type="email" id="confirm-email-address" name="email"
                           autocomplete="username" required />
                </div>

                <button type="submit" class="btn btn-primary btn-block">@L["Send a new link"]</button>
            </form>
        }
    </div>
</div>

@code {
    [CascadingParameter] public HttpContext? Http { get; set; }

    /*
    Both bound as text, never as a typed parameter.

    Blazor converts a query-string value during binding and throws on anything it cannot
    convert, before any validation here runs — which is how ?page=abc became an
    unauthenticated 500 on the catalog. These two arrive from a link in an email and are
    attacker-supplied in full.
    */
    [SupplyParameterFromQuery(Name = MailedTokenLink.UserIdParameter)]
    public string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = MailedTokenLink.TokenParameter)]
    public string? Token { get; set; }

    private bool _confirmed;

    /// <summary>Whether a posted confirmation was refused.</summary>
    private bool _refused;

    /// <summary>Whether a link was being followed, rather than someone asking for one.</summary>
    private bool HasLink => !string.IsNullOrWhiteSpace(UserId) || !string.IsNullOrWhiteSpace(Token);

    private async Task ConfirmAsync()
    {
        // From the body, as the reset page does, so the post does not depend on the query
        // string surviving it. Both are validated again below either way.
        var form = Http?.Request.Form;

        _confirmed = await TryConfirmAsync(
            form?[MailedTokenLink.UserIdParameter].ToString(),
            form?[MailedTokenLink.TokenParameter].ToString());
        _refused = !_confirmed;
    }

    private async Task<bool> TryConfirmAsync(string? userId, string? encodedToken)
    {
        var token = MailedTokenLink.TryDecode(encodedToken);

        if (string.IsNullOrWhiteSpace(userId) || token is null)
        {
            return false;
        }

        var user = await Users.FindByIdAsync(userId);

        if (user is null)
        {
            return false;
        }

        /*
        The store is checked as well as the token, because a token is only evidence about an
        address — it says nothing about which of the stores run from here the link came from.
        The username carries the store, so comparing against this request's site is what stops
        a link issued for one tenant confirming a login on another tenant's domain.
        */
        if (!SiteQualifiedUserName.BelongsTo(user.UserName ?? string.Empty, SiteContext.Site.SiteKey))
        {
            Logger.LogInformation(
                "Refused an email confirmation for a login belonging to another store at {SiteKey}.",
                SiteContext.Site.SiteKey);

            return false;
        }

        // Identity validates the token against the user's security stamp, and confirming
        // changes that stamp — so a link cannot be replayed. Nothing here is single-use of its
        // own making, which is the point: the T3 plan asks for single-use expiring tokens and
        // rolling them by hand is how you get neither.
        var result = await Users.ConfirmEmailAsync(user, token);

        if (!result.Succeeded)
        {
            Logger.LogInformation(
                "Email confirmation refused at {SiteKey}: {Errors}.",
                SiteContext.Site.SiteKey,
                string.Join(", ", result.Errors.Select(error => error.Code)));
        }

        return result.Succeeded;
    }
}
