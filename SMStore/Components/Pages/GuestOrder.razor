@* A guest's order (T12). The token in the address is the only key: a guest has no session,
   and the reference on the page is guessable. *@
@page "/orders/{Token}"

@using SMStore.Ordering
@inject ISiteContext SiteContext
@inject CustomerOrderPresenter Documents

<PageTitle>@(_order?.Reference ?? L["Not found"].Value) · @SiteContext.Site.Name</PageTitle>

@if (_order is null)
{
    @* One answer for a token that is malformed, unknown or another store's. *@
    <div class="page-header">
        <div>
            <h1>@L["Not found"]</h1>
            <p class="page-lede">@L["This link does not open an order. Use the link in the email we sent when you ordered."]</p>
        </div>
    </div>
}
else
{
    <div class="page-header">
        <div>
            <h1 class="mono">@_order.Reference</h1>
            <p class="page-lede">@L["Placed {0}", _order.Placed.ToString("d MMM yyyy")]</p>
        </div>
        <span class="tag tag-neutral">@_order.Status</span>
    </div>

    @if (Placed)
    {
        @* The link is the way back, and saying so is the one thing this page must not leave
           out: a guest who closes the tab has nothing else. *@
        <p class="document__notice" role="status">
            @L["Thank you. We have your order, and we have emailed you a link to this page. Keep it: it is the only way back to your order."]
        </p>
    }

    <PaymentNotice Order="_order" Paid="@PaidFlag" Payment="@PaymentFlag" />

    <OrderDocument Order="_order" PayToken="@Token" />
}

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    /// <summary>Set by the checkout's redirect. Only ever compared, never rendered.</summary>
    [SupplyParameterFromQuery(Name = "placed")]
    public string? PlacedFlag { get; set; }

    private bool Placed => PlacedFlag == "1";

    /// <summary>Set by the provider's return and by a failed "Pay now" (T13). Compared, never rendered.</summary>
    [SupplyParameterFromQuery(Name = "paid")]
    public string? PaidFlag { get; set; }

    [SupplyParameterFromQuery(Name = "payment")]
    public string? PaymentFlag { get; set; }

    private OrderView? _order;

    protected override void OnParametersSet() => _order = Documents.GuestOrder(Token);
}
