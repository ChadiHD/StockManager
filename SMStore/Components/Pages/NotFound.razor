@page "/not-found"
@layout MainLayout
@inject ISiteContext SiteContext

<PageTitle>@L["Page not found"] · @SiteContext.Site.Name</PageTitle>

<div class="page-header">
    <div>
        <h1>@L["Page not found"]</h1>
        <p class="page-lede">
            @L["That address does not exist on this store. It may have moved, or the link that brought you here may be out of date."]
        </p>
    </div>
</div>

<div class="notfound__actions">
    <a href="/" class="btn btn-secondary">@L["Back to home"]</a>
    <a href="/catalog" class="btn btn-primary blueprint">
        <i class="corner tl"></i><i class="corner tr"></i>
        <i class="corner bl"></i><i class="corner br"></i>
        @L["Browse the catalog"]
    </a>
</div>
