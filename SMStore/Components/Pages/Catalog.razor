@page "/catalog"
@using SMStore.Catalog
@inject ISiteContext SiteContext
@inject CatalogPresenter Presenter
@inject NavigationManager Navigation

<PageTitle>@Heading · @SiteContext.Site.Name</PageTitle>

<Breadcrumb Items="Crumbs" />

<div class="page-header">
    <div>
        <h1>@Heading</h1>
        @if (!string.IsNullOrWhiteSpace(Blurb))
        {
            <p class="page-lede">@Blurb</p>
        }
    </div>
</div>

<div class="catalog">
    <aside class="catalog__filters">
        @* A GET form, so every filtered view is a real address: linkable, shareable, and
           re-rendered by the server with no circuit. The controls carry their own names and
           the browser assembles the query string. *@
        <form method="get" action="/catalog">
            <div class="catalog__filters-head">
                <h6>@L["Filters"]</h6>
                @if (HasFilters)
                {
                    <a href="/catalog" class="btn btn-ghost">@L["Clear"]</a>
                }
            </div>

            <div class="field catalog__filter-block">
                <label for="cat-q">@L["Search"]</label>
                <input class="input" type="search" id="cat-q" name="q" value="@Q"
                       placeholder="@L["SKU, part number or name"]" />
            </div>

            <div class="catalog__filter-block">
                <h6>@L["Category"]</h6>
                <ul class="catalog__facets">
                    <li>
                        <a href="@FacetHref("cat", null)" class="@(Cat is null ? "is-current" : null)">
                            <span>@L["All categories"]</span>
                        </a>
                    </li>
                    @foreach (var facet in _result.Categories)
                    {
                        <li>
                            <a href="@FacetHref("cat", facet.Slug)"
                               class="@(Cat == facet.Slug ? "is-current" : null)">
                                <span>@facet.Name</span>
                                <span class="catalog__count">@facet.Count</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>

            @if (_result.Brands.Count > 0)
            {
                <div class="catalog__filter-block">
                    <h6>@L["Brand"]</h6>
                    <ul class="catalog__facets">
                        @foreach (var facet in _result.Brands.Take(12))
                        {
                            <li>
                                <a href="@FacetHref("brand", facet.Name)"
                                   class="@(Brand == facet.Name ? "is-current" : null)">
                                    <span>@facet.Name</span>
                                    <span class="catalog__count">@facet.Count</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }

            @* A group per option the store's variants carry (T11). The heading is the store's
               own word for it, Size or Tamanho, so it is data rather than a key. *@
            @foreach (var group in _result.Options.GroupBy(facet => facet.Name))
            {
                <div class="catalog__filter-block">
                    <h6>@group.Key</h6>
                    <ul class="catalog__facets">
                        @foreach (var facet in group)
                        {
                            var option = new SMDataManager.Library.Models.CatalogOption(facet.Name, facet.Value);
                            <li>
                                <a href="@OptionHref(option)" class="@(_options.Contains(option) ? "is-current" : null)">
                                    <span>@facet.Value</span>
                                    <span class="catalog__count">@facet.Count</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }

            <div class="catalog__filter-block">
                <h6>@L["Availability"]</h6>
                <label class="radio">
                    <input type="checkbox" name="stock" value="1" checked="@InStock" />
                    <span class="dot"></span>
                    <span>@L["In stock only"]</span>
                </label>
            </div>

            @* Keeps the current category and brand when the form posts the search box. *@
            @if (Cat is not null)
            {
                <input type="hidden" name="cat" value="@Cat" />
            }
            @if (Brand is not null)
            {
                <input type="hidden" name="brand" value="@Brand" />
            }
            @foreach (var option in _options)
            {
                <input type="hidden" name="opt" value="@CatalogPresenter.Encode(option)" />
            }

            <button type="submit" class="btn btn-secondary btn-block">@L["Apply"]</button>
        </form>
    </aside>

    <section class="catalog__results">
        <div class="catalog__toolbar">
            <div class="catalog__count-line">
                <strong>@_result.TotalCount.ToString("N0")</strong>
                @(_result.TotalCount == 1 ? L["product"] : L["products"])
                @if (!string.IsNullOrWhiteSpace(Q))
                {
                    <span class="tag tag-neutral catalog__term">@L["“{0}”", Q]</span>
                }
            </div>

            <div class="catalog__sort">
                <span class="text-muted">@L["Sort"]</span>
                @foreach (var option in SortOptions.Where(option => Presenter.SortFor(option.Key) is not null))
                {
                    <a href="@FacetHref("sort", option.Key)"
                       class="@(CurrentSort == option.Key ? "is-current" : null)">@option.Label</a>
                }
            </div>
        </div>

        @if (_result.Items.Count == 0)
        {
            <div class="stub">
                <p><strong>@L["No products match"]</strong></p>
                <p>@L["Try widening your filters, or ask us to source it."]</p>
                <a href="/contact" class="btn btn-secondary">@L["Ask us to source it"]</a>
            </div>
        }
        else
        {
            <div class="product-grid">
                @foreach (var item in _result.Items)
                {
                    <ProductCard Product="item" ReturnTo="@_returnTo" />
                }
            </div>

            <Pager CurrentPage="_result.Page" TotalPages="_result.TotalPages" />
        }
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "cat")] public string? Cat { get; set; }
    [SupplyParameterFromQuery(Name = "brand")] public string? Brand { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "stock")] public string? Stock { get; set; }
    // Several values, each "Name:Value" (T11), parsed by the presenter because they arrive in a
    // URL anybody can write.
    [SupplyParameterFromQuery(Name = "opt")] public string[]? Opt { get; set; }
    // Bound as text rather than int?. Blazor's query binding throws on a value it cannot
    // convert, and that surfaces as an unauthenticated 500 from one query string — "?page=abc"
    // from a crawler, or any number past int.MaxValue. Anything unparseable is page 1, which
    // is what someone editing a URL by hand meant anyway.
    [SupplyParameterFromQuery(Name = "page")] public string? Page { get; set; }

    private int PageNumber => int.TryParse(Page, out var page) ? page : 1;

    private CatalogResult _result = default!;
    private IReadOnlyList<SMDataManager.Library.Models.CatalogOption> _options = [];
    private SMDataManager.Library.Models.SiteCategoryModel? _category;

    /// <summary>
    /// This listing, filters and page included, so an add from a card comes back to it.
    /// </summary>
    /// <remarks>
    /// A relative path, because the endpoint only honours one: the value travels through a
    /// form field and comes back as returnUrl, where an absolute URL would be refused and
    /// silently send the customer to the basket instead.
    /// </remarks>
    private string _returnTo = "/catalog";

    private bool InStock => Stock == "1";

    private string CurrentSort => Presenter.SortFor(Sort) ?? "featured";

    private bool HasFilters =>
        Cat is not null || Brand is not null || !string.IsNullOrWhiteSpace(Q) || InStock || _options.Count > 0;

    // A property rather than a static field, so the labels are looked up in this request's
    // culture rather than in whichever one first touched the type.
    private static (string Key, string Label)[] SortOptions =>
    [
        ("featured", L["Featured"]),
        ("price-asc", L["Price ↑"]),
        ("price-desc", L["Price ↓"]),
        ("name", L["Name"])
    ];

    private string Heading => _category?.Name ?? L["Catalog"];

    private string? Blurb => _category?.Blurb
        ?? L["Everything the store carries, from own stock and distributor feeds alike."];

    private NavItem[] Crumbs => _category is null
        ? [new(L["Home"], "/"), new(L["Catalog"], "/catalog")]
        : [new(L["Home"], "/"), new(L["Catalog"], "/catalog"), new(_category.Name, $"/catalog?cat={_category.Slug}")];

    protected override void OnParametersSet()
    {
        _returnTo = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

        _options = CatalogPresenter.ParseOptions(Opt);
        _result = Presenter.Search(Cat, Brand, InStock, Q, Sort, PageNumber, _options);

        _category = Cat is null
            ? null
            : Presenter.GetCategories().FirstOrDefault(c => c.Slug == Cat);
    }

    /// <summary>
    /// Changes one facet and drops the page number — page 7 of the old result set means
    /// nothing in the new one, and landing on an empty page is the classic faceting bug.
    /// </summary>
    private string FacetHref(string key, string? value)
    {
        var uri = Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            [key] = string.IsNullOrWhiteSpace(value) ? null : value,
            ["page"] = null
        });

        return uri;
    }

    /// <summary>
    /// Adds an option value to the filter, or takes it away when it is already there, and drops
    /// the page number for <see cref="FacetHref"/>'s reason.
    /// </summary>
    private string OptionHref(SMDataManager.Library.Models.CatalogOption option)
    {
        var next = _options.Contains(option)
            ? _options.Where(selected => selected != option)
            : _options.Append(option);

        var encoded = next.Select(CatalogPresenter.Encode).ToArray();

        return Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["opt"] = encoded.Length == 0 ? null : encoded,
            ["page"] = null
        });
    }
}
