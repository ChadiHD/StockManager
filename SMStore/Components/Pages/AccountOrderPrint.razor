@page "/account/orders/{Reference}/print"

@using SMStore.Accounts
@using SMStore.Ordering
@inject ISiteContext SiteContext
@inject ICustomerContext Customer
@inject CustomerOrderPresenter Documents
@inject NavigationManager Navigation

<PageTitle>@Reference · @SiteContext.Site.Name</PageTitle>

@if (_order is null || _party is null)
{
    <div class="page-header">
        <div>
            <h1>@L["Not found"]</h1>
            <p class="page-lede">@L["We have no order with that reference on your account."]</p>
        </div>
    </div>

    <a href="@QuoteDecisionEndpoints.OrdersPath" class="btn btn-secondary">@L["Back to your orders"]</a>
}
else
{
    <div class="sheet__actions">
        <a href="@($"{QuoteDecisionEndpoints.OrdersPath}/{Reference}")" class="btn btn-secondary">
            @L["Back to the order"]
        </a>
        <button type="button" class="btn btn-primary" data-print>@L["Print or save as PDF"]</button>
    </div>

    <DocumentSheet Kind="@(L["Order"])"
                   Reference="@_order.Reference"
                   Party="_party"
                   Meta="Meta"
                   Lines="_order.Lines"
                   Totals="Totals"
                   FooterNote="@FooterNote" />
}

@code {
    [Parameter] public string Reference { get; set; } = string.Empty;

    private OrderView? _order;
    private DocumentParty? _party;

    private IReadOnlyList<(string, string)> Meta
    {
        get
        {
            var meta = new List<(string, string)>
            {
                (L["Status"], _order!.Status),
                (L["Placed"], _order.Placed.ToString("d MMM yyyy")),
            };

            // Both are absent on a POS-shaped row and on an order raised without one, so
            // neither gets an empty line on a document somebody files.
            if (!string.IsNullOrWhiteSpace(_order.PoNumber))
            {
                meta.Add((L["Your PO number"], _order.PoNumber));
            }

            if (!string.IsNullOrWhiteSpace(_order.FromQuoteReference))
            {
                meta.Add((L["From quote"], _order.FromQuoteReference));
            }

            return meta;
        }
    }

    private IReadOnlyList<(string, string)> Totals =>
    [
        (L["Lines"], _order!.Lines.Count.ToString()),
        (L["Subtotal"], _order.SubTotal),
        // Named by treatment rather than "VAT", because a reverse-charged or exported order
        // carries nothing and saying "VAT 0.00" without saying why is what an accountant
        // sends back.
        (string.IsNullOrWhiteSpace(_order.TaxTreatment) ? L["Tax"] : _order.TaxTreatment, _order.Tax),
        (L["Total"], _order.Total),
    ];

    /// <summary>
    /// The legend the order was raised under, which is the part a customer's accountant
    /// looks for — a zero-rated line with no statement of why is a query back to the store.
    /// Snapshotted at acceptance, so an order raised before T6 has none and says the older
    /// thing instead.
    /// </summary>
    private string FooterNote => string.IsNullOrWhiteSpace(_order!.TaxLegend)
        ? L["Tax and freight are confirmed on the invoice."]
        : $"{_order.TaxLegend} {L["Freight is confirmed on the invoice."]}";

    protected override void OnParametersSet()
    {
        if (!Customer.IsSignedIn)
        {
            var target = $"{QuoteDecisionEndpoints.OrdersPath}/{Uri.EscapeDataString(Reference)}/print";

            Navigation.NavigateTo(
                $"{CustomerAuthentication.LoginPath}?returnUrl={Uri.EscapeDataString(target)}");

            return;
        }

        _order = Documents.Order(Reference);
        _party = Documents.Party();
    }
}
