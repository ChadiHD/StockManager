@page "/"
@inject ISiteContext SiteContext
@inject OrderingModeProvider Ordering

<PageTitle>@SiteContext.Site.Name</PageTitle>

<section class="home-hero">
    <p class="card-kicker">@SiteContext.Site.Country · @SiteContext.Site.CurrencyCode</p>
    <h1>@SiteContext.Site.Name</h1>
    <p class="page-lede">
        Storefront chrome and the design system are in place. The hero copy, category grid and
        featured products arrive with the content mechanism and the catalog.
    </p>

    <div class="home-hero__actions">
        <a href="/catalog" class="btn btn-primary blueprint">
            <i class="corner tl"></i><i class="corner tr"></i>
            <i class="corner bl"></i><i class="corner br"></i>
            Browse the catalog
        </a>
        <a href="@Ordering.Current.BasketRoute" class="btn btn-secondary">
            @Ordering.Current.SubmitBasketLabel
        </a>
    </div>
</section>

<div class="stub">
    Category grid, featured products and supply-performance panels land with T2.
</div>
