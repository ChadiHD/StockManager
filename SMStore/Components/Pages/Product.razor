@page "/product/{Sku}"
@using SMStore.Catalog
@using SMStore.Ordering
@inject ISiteContext SiteContext
@inject CatalogPresenter Catalog
@inject OrderingModeProvider Ordering

@if (_item is null)
{
    @* A hidden or unmapped product is indistinguishable from a wrong SKU, deliberately: a
       404 for both means a guessed SKU cannot confirm that a product exists but is withheld. *@
    <PageTitle>@L["Product not found"] · @SiteContext.Site.Name</PageTitle>

    <div class="page-header">
        <div>
            <h1>@L["Product not found"]</h1>
            <p class="page-lede">
                @L["No product with that code is available on this store."]
            </p>
        </div>
    </div>

    <a href="/catalog" class="btn btn-secondary">@L["Back to the catalog"]</a>
}
else
{
    <PageTitle>@_item.ProductName · @SiteContext.Site.Name</PageTitle>

    <Breadcrumb Items="Crumbs" />

    <div class="product">
        <div class="product__media blueprint">
            <i class="corner tl"></i><i class="corner tr"></i>
            <i class="corner bl"></i><i class="corner br"></i>
            @if (!string.IsNullOrWhiteSpace(_item.ProductImage))
            {
                <img src="@_item.ProductImage" alt="@_item.ProductName" />
            }
            else
            {
                <div class="product__noimage">@L["No image"]</div>
            }
        </div>

        <div class="product__buy">
            <div class="card-kicker">@Brand</div>
            <h1>@_item.ProductName</h1>

            <div class="product__ids">
                <span>@L["SKU {0}", _item.Sku]</span>
                @if (!string.IsNullOrWhiteSpace(_item.ManufacturerPartNumber))
                {
                    <span>@L["MPN {0}", _item.ManufacturerPartNumber]</span>
                }
                @if (!string.IsNullOrWhiteSpace(_item.Ean))
                {
                    <span>@L["EAN {0}", _item.Ean]</span>
                }
            </div>

            <span class="tag @(InStock ? "tag-accent" : "tag-neutral")">@Availability</span>

            @if (Price is not null)
            {
                <div class="product__price">
                    <span class="product__amount">@Price</span>
                    <span class="text-muted">@PriceNote</span>
                </div>
            }
            else
            {
                <p class="text-muted">@L["Sign in to see pricing for your account."]</p>
            }

            <div class="product__actions">
                @* A form, not an @onclick: this page renders with static SSR and there is no
                   circuit for an event to arrive on. Posts the SKU rather than a product id,
                   so no database id appears in storefront markup. *@
                <form method="post" action="@BasketEndpoints.AddPath" class="product__add">
                    <AntiforgeryToken />
                    @if (_page!.Variants.Count > 0)
                    {
                        @* The size and colour are chosen here, and the variant's own SKU is what
                           posts: a style with variants cannot itself go in a basket (T11). One
                           select rather than a control per option, because without a script
                           a second control could not narrow the first. *@
                        <label class="visually-hidden" for="add-variant">@_page.ChoiceLabel</label>
                        <select class="input product__variant" id="add-variant" name="sku">
                            @foreach (var variant in _page.Variants)
                            {
                                <option value="@variant.Sku" selected="@(variant.Sku == _page.SelectedSku)">
                                    @(variant.InStock ? variant.Label : L["{0} (out of stock)", variant.Label])
                                </option>
                            }
                        </select>
                    }
                    else
                    {
                        <input type="hidden" name="sku" value="@_item.Sku" />
                    }
                    <input type="hidden" name="returnUrl" value="@CurrentPath" />
                    <label class="visually-hidden" for="add-qty">@L["Quantity"]</label>
                    <input class="input product__add-qty" type="number" id="add-qty"
                           name="quantity" value="1" min="1" max="9999" step="1" />
                    <button type="submit" class="btn btn-primary blueprint">
                        <i class="corner tl"></i><i class="corner tr"></i>
                        <i class="corner bl"></i><i class="corner br"></i>
                        @Ordering.Current.AddToBasketLabel
                    </button>
                </form>
                <a href="@Ordering.Current.BasketRoute" class="btn btn-secondary">
                    @L["View your {0}", Ordering.Current.BasketNoun]
                </a>
            </div>

            @if (_item.LastSynced is not null)
            {
                @* Distributor stock is only as fresh as the last sync, so the page says when
                   rather than implying the number is live. *@
                <p class="text-muted product__freshness">
                    @L["Distributor stock last confirmed {0} UTC. Subject to confirmation at quote.", _item.LastSynced.Value.ToString("d MMM yyyy HH:mm")]
                </p>
            }
        </div>
    </div>

    <section class="product__detail">
        <h2>@L["Description"]</h2>
        @if (!string.IsNullOrWhiteSpace(_item.Description))
        {
            <p class="product__description">@_item.Description</p>
        }
        else
        {
            <div class="stub">@L["No description is published for this product."]</div>
        }

        <h2>@L["Specifications"]</h2>
        @* The artboard renders a spec table and a document list. Nothing stores either, and
           the Icecat licence that would populate them is deferred, so this empty state is the
           common case rather than an edge case — see the plan's risks. *@
        <div class="stub">@L["No specifications are published for this product."]</div>
    </section>
}

@code {
    [Parameter] public string Sku { get; set; } = string.Empty;

    private ProductPage? _page;

    private SMDataManager.Library.Models.CatalogItemModel? _item => _page?.Product;

    private bool InStock => _item is { QuantityInStock: > 0 };

    private string Availability => InStock ? L["In stock"] : L["Lead time on request"];

    private string Brand => string.IsNullOrWhiteSpace(_item?.Manufacturer)
        ? _item?.Distributor ?? string.Empty
        : _item.Manufacturer;

    private string? Price => _item is null ? null : Catalog.FormatPrice(_item);

    private string PriceNote => (Ordering.Current.ShowsPayableTotal, SiteContext.Site.PricesIncludeTax) switch
    {
        (true, true) => L["incl. tax"],
        (true, false) => L["excl. tax"],
        (false, true) => L["list, incl. tax — volume pricing on quote"],
        (false, false) => L["list, excl. tax — volume pricing on quote"]
    };

    /// <summary>Where an add returns to, so the customer stays on the product page.</summary>
    /// <remarks>
    /// Built from the route parameter rather than read from NavigationManager, because the
    /// value goes into a form field that comes back as returnUrl — and the endpoint only
    /// honours a local path, so a value derived from the request would be checked twice for
    /// no gain and be harder to read.
    /// </remarks>
    private string CurrentPath => $"/product/{Uri.EscapeDataString(Sku)}";

    private NavItem[] Crumbs =>
    [
        new(L["Home"], "/"),
        new(L["Catalog"], "/catalog"),
        new(_item!.CategoryName, $"/catalog?cat={_item.CategorySlug}"),
        new(_item.Sku, $"/product/{_item.Sku}")
    ];

    protected override void OnParametersSet() => _page = Catalog.GetProductPage(Sku);
}
